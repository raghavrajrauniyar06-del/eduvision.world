.skip-btn{position:absolute;bottom:clamp(18px,3vh,32px);right:clamp(14px,3vw,32px);z-index:30;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.13);color:rgba(255,255,255,.42);padding:clamp(6px,1vw,9px) clamp(14px,2.5vw,22px);border-radius:99px;font-size:clamp(.62rem,.8vw + .3rem,.76rem);font-weight:600;cursor:pointer;letter-spacing:.14em;text-transform:uppercase;opacity:0;animation:fade-up .6s ease 1.2s both;transition:all .28s;backdrop-filter:blur(10px);}
