.section-sub-center{margin-left:auto;margin-right:auto;}
.text-center{text-align:center;}
.gold-word{color:var(--gold-2);}

/* ── Premium reveal system ── */
.reveal,.reveal-left,.reveal-right,.ru,.rl,.rr,.rs{
  opacity:0;will-change:opacity,transform;backface-visibility:hidden;
}
.reveal{transform:translateY(32px) scale(.97);
  transition:opacity .75s cubic-bezier(.22,1,.36,1),transform .75s cubic-bezier(.22,1,.36,1);}
.reveal.in{opacity:1;transform:translateY(0) scale(1);}
.reveal-left{transform:translate(-32px,18px) scale(.98);
  transition:opacity .75s cubic-bezier(.22,1,.36,1),transform .75s cubic-bezier(.22,1,.36,1);}
.reveal-left.in{opacity:1;transform:translate(0,0) scale(1);}
.reveal-right{transform:translate(32px,18px) scale(.98);
  transition:opacity .75s cubic-bezier(.22,1,.36,1),transform .75s cubic-bezier(.22,1,.36,1);}
.reveal-right.in{opacity:1;transform:translate(0,0) scale(1);}
/* stagger delays */
.d1{transition-delay:.06s!important;}
.d2{transition-delay:.12s!important;}
.d3{transition-delay:.18s!important;}
.d4{transition-delay:.24s!important;}
.d5{transition-delay:.30s!important;}
.d1{transition-delay:.05s!important;}.d2{transition-delay:.12s!important;}.d3{transition-delay:.2s!important;}
.d4{transition-delay:.28s!important;}.d5{transition-delay:.36s!important;}.d6{transition-delay:.44s!important;}

/* ═══ COURSES ═══ */
#courses{background-color:#fdfbf7;background-image:linear-gradient(to bottom,rgba(253,251,247,.88) 0%,rgba(253,251,247,.96) 100%),url('champagne_hero_bg.jpg');background-size:auto,cover;background-position:center center,center 40%;background-repeat:no-repeat;padding:56px 0;border-top:1px solid rgba(0,0,0,.05);position:relative;overflow:visible;box-shadow:none;}
.courses-header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:40px;gap:24px;flex-wrap:wrap;}
/* ═══ COURSE SEARCH — GOOGLE-INSPIRED PREMIUM (single source of truth) ═══
   Architecture:
   .gsearch-wrap   → positioning context, width:min(100%,760px), centered
   .gsearch-bar    → the pill-shaped input row
   .gsearch-panel  → suggestions panel
     - Desktop/tablet (≥768px): absolutely positioned below the bar (Option A),
       fully opaque, high z-index, never affects document flow.
     - Mobile (<768px): sits in normal document flow (Option B). It is always
       rendered but collapsed to 0 height when closed, and expands to push the
       category filters / course cards down when open — this removes any
       possibility of overlapping the filters below it.
═══════════════════════════════════════════════════════════════════════════ */
.gsearch-wrap{
  position:relative;
  width:min(100%,760px);
  margin:0 auto 44px;
  box-sizing:border-box;
  z-index:50;
}
#courses{position:relative;}
#courses:has(.gsearch-panel.show),
#courses.search-open{z-index:40;}
@keyframes gsearch-rgb-spin{
  0%{ --rgb-angle:0deg; }
  100%{ --rgb-angle:360deg; }
}
@property --rgb-angle{
  syntax:'<angle>';
  inherits:false;
  initial-value:0deg;
}
.gsearch-bar{
  box-sizing:border-box;
  width:100%;
  display:flex;align-items:center;gap:12px;
  padding:16px 22px;border-radius:99px;
  background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.03));
  border:1.5px solid rgba(201,147,42,.22);
  backdrop-filter:blur(16px) saturate(1.4);-webkit-backdrop-filter:blur(16px) saturate(1.4);
  box-shadow:0 10px 34px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.05);
  transition:border-color .3s var(--ease-out),box-shadow .3s var(--ease-out),background .3s;
  position:relative;
  isolation:isolate;
}
/* Ambient RGB glow ring around the search bar (kept strictly OUTSIDE the box
   so its conic-gradient color seams never show through/inside while typing) */
.gsearch-bar::before{
  content:'';
  position:absolute;
  inset:-3px;
  border-radius:inherit;
  padding:3px;
  background:conic-gradient(from var(--rgb-angle,0deg),
    #ff5f6d,#ffc371,#f0c84a,#6ee7b7,#5fc9ff,#7d8bff,#d86ef7,#ff5f6d);
  -webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);
  -webkit-mask-composite:xor;
  mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);
  mask-composite:exclude;
  opacity:0;
  filter:blur(9px);
  transition:opacity .45s ease;
  z-index:-1;
  pointer-events:none;
  animation:gsearch-rgb-spin 6s linear infinite paused;
}
.gsearch-bar::after{
  content:'';
  position:absolute;
  inset:-14px;
  border-radius:inherit;
  background:conic-gradient(from var(--rgb-angle,0deg),
    rgba(255,95,109,.35),rgba(255,195,113,.35),rgba(240,200,74,.35),
    rgba(110,231,183,.35),rgba(95,201,255,.35),rgba(125,139,255,.35),
    rgba(216,110,247,.35),rgba(255,95,109,.35));
  opacity:0;
  filter:blur(22px);
  transition:opacity .45s ease;
  z-index:-2;
  pointer-events:none;
  animation:gsearch-rgb-spin 6s linear infinite paused;
}
.gsearch-bar::before,
.gsearch-bar::after{
  opacity:1;
  animation-play-state:running;
}
.gsearch-bar:focus-within{
  border-color:rgba(201,147,42,.7);
  background:linear-gradient(180deg,rgba(201,147,42,.08),rgba(201,147,42,.03));
  box-shadow:0 0 0 4px rgba(201,151,42,.12),0 16px 44px rgba(0,0,0,.4);
}
.gsearch-bar:focus-within::before{ filter:blur(10px); }
.gsearch-bar:focus-within::after{ filter:blur(26px); opacity:1; }
@media (prefers-reduced-motion:reduce){
  .gsearch-bar::before,.gsearch-bar::after{animation:none;}
}
.gsearch-icon{width:20px;height:20px;flex-shrink:0;color:var(--gold-2);opacity:.8;transition:color .3s,opacity .3s,transform .35s var(--spring);}
.gsearch-bar:focus-within .gsearch-icon{color:var(--gold);opacity:1;transform:scale(1.08) rotate(-6deg);}
.gsearch-input{
  flex:1;min-width:0;width:100%;
  background:none;border:none;outline:none;
  font-family:inherit;font-size:1rem;font-weight:500;line-height:1.3;
  color:var(--text);letter-spacing:.01em;
  padding:2px 0;
  text-overflow:ellipsis;
}
.gsearch-input::placeholder{color:var(--muted);opacity:1;}
.gsearch-clear{
  flex-shrink:0;width:26px;height:26px;border-radius:50%;border:none;cursor:pointer;
  display:flex;align-items:center;justify-content:center;color:var(--muted);
  background:rgba(255,255,255,.06);
  opacity:0;transform:scale(.5);pointer-events:none;
  transition:all .2s var(--spring);
}
.gsearch-clear svg{width:13px;height:13px;}
.gsearch-clear.show{opacity:1;transform:scale(1);pointer-events:auto;}
.gsearch-clear:hover{background:rgba(255,255,255,.14);color:var(--text);}

/* ─ Panel: shared base rules ─ */
.gsearch-panel{
  box-sizing:border-box;
  width:100%;
  background:linear-gradient(180deg,#131315,#0a0a0b);
  border:1px solid var(--border-gold);
  border-radius:20px;
  z-index:60;
}
.gsearch-panel-inner{min-width:0;}
.gsearch-panel::-webkit-scrollbar{width:6px;}
.gsearch-panel::-webkit-scrollbar-thumb{background:rgba(201,147,42,.3);border-radius:99px;}
.gsearch-section-label{padding:10px 14px 6px;font-size:.66rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);}
.gsearch-chips{display:flex;flex-wrap:wrap;gap:8px;padding:2px 10px 12px;}
.gsearch-chip{
  box-sizing:border-box;
  display:inline-flex;align-items:center;gap:6px;
  padding:9px 16px;border-radius:99px;
  background:rgba(201,147,42,.08);border:1px solid rgba(201,147,42,.25);
  color:var(--gold-2);font-size:.78rem;font-weight:600;cursor:pointer;
  max-width:100%;
  user-select:none;-webkit-user-select:none;
  transition:background .2s,border-color .2s,transform .2s;
  animation:gsearch-item-in .38s cubic-bezier(.16,1,.3,1) both;
  animation-delay:calc(var(--i,0) * 35ms);
}
.gsearch-chip:hover,.gsearch-chip.active{background:rgba(201,147,42,.2);border-color:rgba(201,147,42,.55);transform:translateY(-1px);}

.gsearch-item{
  box-sizing:border-box;
  width:100%;display:flex;align-items:center;gap:12px;
  padding:12px 14px;border-radius:14px;border:none;background:none;cursor:pointer;
  text-align:left;font-family:inherit;
  transition:background .18s ease,transform .18s cubic-bezier(.22,1,.36,1);
  user-select:none;-webkit-user-select:none;
  animation:gsearch-item-in .38s cubic-bezier(.16,1,.3,1) both;
  animation-delay:calc(var(--i,0) * 35ms);
}
.gsearch-item:hover,.gsearch-item.active{background:rgba(201,147,42,.12);transform:translateX(2px);}
@keyframes gsearch-item-in{
  from{opacity:0;transform:translateY(6px) scale(.98);}
  to{opacity:1;transform:translateY(0) scale(1);}
}
@media (prefers-reduced-motion:reduce){
  .gsearch-item,.gsearch-chip{animation:none!important;}
}
.gsearch-item-icon{font-size:1.15rem;flex-shrink:0;width:34px;height:34px;border-radius:10px;background:rgba(201,147,42,.1);display:flex;align-items:center;justify-content:center;}
.gsearch-item-body{flex:1;min-width:0;}
.gsearch-item-name{font-size:.88rem;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.gsearch-item-name mark{background:rgba(201,147,42,.32);color:var(--gold-2);border-radius:3px;padding:0 1px;font-weight:800;}
.gsearch-item-meta{font-size:.68rem;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.gsearch-item-level{flex-shrink:0;font-size:.62rem;font-weight:700;letter-spacing:.03em;color:var(--gold-2);background:rgba(201,147,42,.12);border:1px solid rgba(201,147,42,.25);border-radius:99px;padding:4px 10px;white-space:nowrap;}

.gsearch-empty{padding:32px 20px;text-align:center;}
.gsearch-empty-icon{font-size:1.8rem;margin-bottom:10px;opacity:.6;}
.gsearch-empty-title{font-size:.88rem;font-weight:700;color:var(--text);margin-bottom:4px;}
.gsearch-empty-sub{font-size:.76rem;color:var(--muted);}

/* ─ Panel: desktop / tablet (≥768px) — OPTION A, absolute overlay ─ */
@media(min-width:768px){
  .gsearch-panel{
    position:absolute;top:calc(100% + 10px);left:0;
    max-height:420px;overflow-y:auto;
    padding:10px;
    box-shadow:0 30px 70px rgba(0,0,0,.55),0 0 0 1px rgba(255,255,255,.03);
    opacity:0;
    transform:translateY(-10px) scale(.97);
    filter:blur(4px);
    pointer-events:none;
    transform-origin:top center;
    will-change:opacity,transform,filter;
    transition:opacity .32s cubic-bezier(.22,1,.36,1),
               transform .38s cubic-bezier(.22,1,.36,1),
               filter .32s cubic-bezier(.22,1,.36,1);
  }
  .gsearch-panel.show{
    opacity:1;transform:translateY(0) scale(1);filter:blur(0);pointer-events:auto;
    transition:opacity .34s cubic-bezier(.16,1,.3,1),
               transform .42s cubic-bezier(.16,1,.3,1),
               filter .3s cubic-bezier(.16,1,.3,1);
  }
  .gsearch-panel:not(.show){
    transition:opacity .18s ease-in,
               transform .2s cubic-bezier(.4,0,1,1),
               filter .18s ease-in;
  }
}

/* ─ Panel: mobile (<768px) — OPTION B, in-flow, pushes content down ─ */
@media(max-width:767px){
  .gsearch-wrap{margin-bottom:24px;}
  .gsearch-bar{padding:13px 16px;gap:10px;}
  .gsearch-input{font-size:.92rem;}
  .gsearch-icon{width:18px;height:18px;}
  .gsearch-panel{
    position:static;
    display:grid;
    grid-template-rows:0fr;
    margin-top:0;
    overflow:hidden;
    border-width:0;
    opacity:0;
    will-change:grid-template-rows,opacity;
    transition:grid-template-rows .4s cubic-bezier(.22,1,.36,1),
               margin-top .4s cubic-bezier(.22,1,.36,1),
               border-width .4s cubic-bezier(.22,1,.36,1),
               opacity .3s ease;
  }
  .gsearch-panel-inner{min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;max-height:60vh;padding:10px;}
  .gsearch-panel.show{
    grid-template-rows:1fr;
    margin-top:10px;
    border-width:1px;
    opacity:1;
    transition:grid-template-rows .42s cubic-bezier(.16,1,.3,1),
               margin-top .42s cubic-bezier(.16,1,.3,1),
               border-width .42s cubic-bezier(.16,1,.3,1),
               opacity .3s ease .06s;
  }
  .gsearch-section-label{padding:8px 10px 6px;font-size:.62rem;}
  .gsearch-chips{padding:2px 6px 10px;gap:7px;}
  .gsearch-chip{padding:8px 14px;font-size:.74rem;}
  .gsearch-item{padding:11px 10px;gap:10px;min-height:44px;}
  .gsearch-item-icon{width:30px;height:30px;font-size:1rem;}
}
.crs-filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:32px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none;}
.crs-filters::-webkit-scrollbar{display:none;}
.crs-tab{padding:7px 18px;border-radius:99px;font-size:.74rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;border:1px solid var(--border);background:rgba(255,255,255,.04);color:var(--muted);transition:all .28s;white-space:nowrap;flex-shrink:0;}
.crs-tab:hover{color:var(--text);border-color:rgba(255,255,255,.15);}
.crs-tab.active{background:rgba(201,151,42,.12);border-color:rgba(201,151,42,.4);color:var(--gold-2);box-shadow:0 0 20px rgba(201,151,42,.1);}
.slider-outer{overflow:hidden;position:relative;display:flex;flex-direction:column;gap:14px;width:100vw;margin-left:calc(50% - 50vw);padding-left:clamp(18px,5vw,24px);padding-right:clamp(18px,5vw,24px);box-sizing:border-box;}
.slider-outer::before,.slider-outer::after{content:'';position:absolute;top:0;bottom:0;width:clamp(60px,8vw,120px);z-index:3;pointer-events:none;}
.slider-outer::before{left:0;background:linear-gradient(90deg,var(--bg) 30%,transparent);}
.slider-outer::after{right:0;background:linear-gradient(-90deg,var(--bg) 30%,transparent);}
.slider-row{display:flex;gap:14px;width:max-content;padding:6px 0;}
.slider-row.fwd{animation:row-fwd 42s linear infinite;}
.slider-row.bwd{animation:row-bwd 50s linear infinite;}
.slider-row:hover{animation-play-state:paused;}
@keyframes row-fwd{from{transform:translateX(0);}to{transform:translateX(-50%);}}
@keyframes row-bwd{from{transform:translateX(-50%);}to{transform:translateX(0);}}
.crs-card{flex-shrink:0;width:clamp(165px,22vw,210px);background:linear-gradient(165deg,rgba(32,36,60,.85) 0%,rgba(18,20,36,.92) 55%,rgba(11,12,22,.95) 100%);border:1px solid rgba(150,160,210,.1);border-radius:20px;padding:clamp(20px,3vw,26px) clamp(16px,2vw,22px) clamp(18px,2.5vw,22px);cursor:pointer;position:relative;overflow:hidden;transition:transform .42s var(--ease-out),border-color .3s,box-shadow .42s;will-change:transform;box-shadow:inset 0 1px 0 rgba(255,255,255,.05),0 12px 30px rgba(0,0,0,.35);}
.crs-card::before{content:'';position:absolute;top:0;left:15%;right:15%;height:1.5px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transform:scaleX(0);transition:opacity .35s,transform .45s var(--ease-out);}
.crs-card:hover{transform:translateY(-12px);border-color:rgba(201,151,42,.3);box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 24px 60px rgba(0,0,0,.5),0 0 30px rgba(201,151,42,.1);}
.crs-card:hover::before{opacity:1;transform:scaleX(1);}
.crs-icon{font-size:2.2rem;display:block;margin-bottom:12px;transition:transform .38s var(--spring);will-change:transform;}
.crs-card:hover .crs-icon{transform:scale(1.2) translateY(-4px);}
.crs-level{font-size:.6rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);background:rgba(201,151,42,.1);border:1px solid rgba(201,151,42,.18);border-radius:99px;padding:3px 10px;display:inline-block;margin-bottom:8px;}
.crs-name{font-size:.88rem;font-weight:700;color:var(--text);line-height:1.28;transition:color .25s;}
.crs-card:hover .crs-name{color:var(--gold-2);}
.crs-hint{margin-top:12px;font-size:.68rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:rgba(255,255,255,.2);display:flex;align-items:center;gap:6px;transition:color .25s,gap .3s;}
.crs-card:hover .crs-hint{color:rgba(201,151,42,.6);gap:10px;}
.crs-hint-arr{transition:transform .28s;}
.crs-card:hover .crs-hint-arr{transform:translateX(4px);}

/* ═══ ABOUT ═══ */
