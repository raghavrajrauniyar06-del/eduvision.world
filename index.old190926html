/* ══════════════════════════════════════════════════
   CHAT WINDOW — FIXED POPUP, APPEARS IN PLACE
   NOTE: bottom is NOT hardcoded here — it's set dynamically by
   positionChatToggleAboveFabDock() in JS so it always sits just
   above the fab-dock + AI button, regardless of dock height.
══════════════════════════════════════════════════ */
#chatWindow {
  position: fixed !important;
  /* Desktop: anchored bottom-right above button */
  right: 24px !important;
  left: auto !important;
  top: auto !important;
  width: 360px !important;
  height: 520px !important;
  max-height: min(560px, calc(100vh - 160px)) !important;
  transform-origin: bottom right !important;
  will-change: transform, opacity !important;
  z-index: 8500 !important;
  border-radius: 20px !important;
  overflow: hidden !important;
  display: flex !important;
  flex-direction: column !important;
  background: rgba(8,8,10,.97) !important;
  border: 1px solid rgba(201,147,42,.22) !important;
  box-shadow:
    0 24px 60px rgba(0,0,0,.85),
    0 0 0 1px rgba(255,255,255,.06),
    inset 0 1px 0 rgba(255,255,255,.08) !important;
  backdrop-filter: blur(30px) saturate(1.8) !important;
  -webkit-backdrop-filter: blur(30px) saturate(1.8) !important;
  isolation: isolate !important;
}

/* Always-on rotating RGB border ring — same style as the course search bar.
   Kept at inset:0 (not negative) so it stays fully inside the box and is
   never clipped by #chatWindow's overflow:hidden (needed for message scroll). */
#chatWindow::before{
  content:'';
  position:absolute;
  inset:0;
  border-radius:inherit;
  padding:2.5px;
  background:conic-gradient(from var(--rgb-angle,0deg),
    #ff5f6d,#ffc371,#f0c84a,#6ee7b7,#5fc9ff,#7d8bff,#d86ef7,#ff5f6d);
  -webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);
  -webkit-mask-composite:xor;
  mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);
  mask-composite:exclude;
  opacity:1;
  z-index:2;
  pointer-events:none;
  animation:gsearch-rgb-spin 6s linear infinite;
}
@media (prefers-reduced-motion:reduce){
  #chatWindow::before{animation:none;}
}

/* CLOSED */
#chatWindow:not(.open) {
  opacity: 0 !important;
  transform: scale(.86) translateY(10px) !important;
  pointer-events: none !important;
  transition:
    transform .25s cubic-bezier(.55,0,.45,1),
    opacity .18s ease !important;
}

/* OPEN — pops up in place with spring */
#chatWindow.open {
  opacity: 1 !important;
  transform: scale(1) translateY(0) !important;
  pointer-events: all !important;
  transition:
    transform .45s cubic-bezier(.16,1.2,.3,1),
    opacity .28s ease !important;
}

/* MOBILE — popup above button, no scrolling */
@media (max-width: 640px) {
  #chatWindow {
    right: 8px !important;
    left: 8px !important;
    width: auto !important;
    height: 460px !important;
    max-height: min(460px, calc(100svh - 180px)) !important;
    border-radius: 18px !important;
    backdrop-filter: blur(20px) !important;
    -webkit-backdrop-filter: blur(20px) !important;
  }
}

