      <script>
        function filterUniMode(mode, btn) {
          document.querySelectorAll('.uni-tab').forEach(function(b) {
            b.classList.remove('active');
            b.style.background = '#ffffff';
            b.style.color = '#1c1917';
            b.style.borderColor = '#d4d4d8';
            b.style.boxShadow = '0 2px 8px rgba(0,0,0,0.06)';
          });
          btn.classList.add('active');
          btn.style.background = 'var(--gold)';
          btn.style.color = '#000000';
          btn.style.borderColor = 'var(--gold)';
          btn.style.boxShadow = '0 6px 20px rgba(201,147,42,0.5)';

          var reg = document.getElementById('uniSecRegular');
          var onl = document.getElementById('uniSecOnline');
          var dis = document.getElementById('uniSecDistance');

          if (mode === 'all') {
            if(reg) reg.style.display = 'block';
            if(onl) onl.style.display = 'block';
            if(dis) dis.style.display = 'block';
          } else if (mode === 'regular') {
            if(reg) { reg.style.display = 'block'; reg.scrollIntoView({behavior: 'smooth', block: 'start'}); }
            if(onl) onl.style.display = 'none';
            if(dis) dis.style.display = 'none';
          } else if (mode === 'online') {
            if(onl) { onl.style.display = 'block'; onl.scrollIntoView({behavior: 'smooth', block: 'start'}); }
            if(reg) reg.style.display = 'none';
            if(dis) dis.style.display = 'none';
          } else if (mode === 'distance') {
            if(dis) { dis.style.display = 'block'; dis.scrollIntoView({behavior: 'smooth', block: 'start'}); }
            if(reg) reg.style.display = 'none';
            if(onl) onl.style.display = 'none';
          }
        }
