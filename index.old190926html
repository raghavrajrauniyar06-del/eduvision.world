let _cmCtx,_cmW=700,_cmH=190,_cmP=[],_cmAnim,_cmOn=false;
function startCmParticles(){
  const c=document.getElementById('cmCanvas'); if(!c) return;
  _cmCtx=c.getContext('2d');
  const rect=c.parentElement.getBoundingClientRect();
  _cmW=c.width=Math.round(rect.width)||700; _cmH=c.height=190;
  _cmP=[]; for(let i=0;i<(isMobile?12:40);i++) _cmP.push(_newP());
  _cmOn=true; cancelAnimationFrame(_cmAnim);
  const _cmFrameTime = 1000/90; let _cmLast = 0;
  (function loop(ts){ if(!_cmOn)return; _cmAnim=requestAnimationFrame(loop); if(ts-_cmLast<_cmFrameTime)return; _cmLast=ts; _cmCtx.clearRect(0,0,_cmW,_cmH); _cmP.forEach(p=>{p.x+=p.vx;p.y+=p.vy;p.life++; if(p.life>p.max||p.x<0||p.x>_cmW||p.y<0||p.y>_cmH)Object.assign(p,_newP()); _cmCtx.save(); _cmCtx.globalAlpha=p.a*(1-p.life/p.max); _cmCtx.beginPath();_cmCtx.arc(p.x,p.y,p.r,0,Math.PI*2); _cmCtx.fillStyle=`rgba(${p.c},1)`;_cmCtx.fill(); _cmCtx.restore();}); })();
}
