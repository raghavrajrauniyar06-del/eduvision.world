  --border:rgba(255,255,255,.08);
  --border-gold:rgba(201,147,42,.25);
  --ease-out:cubic-bezier(.16,1,.3,1);
  --spring:cubic-bezier(.34,1.56,.64,1);
  --snap:cubic-bezier(.77,0,.18,1);
  --section-y:clamp(72px,9vw,120px);
  --container:min(1180px,94vw);
  --navy2:#1e1e1e;--elec:#c9932a;--elec2:#e8b42a;--gold2:#e8b42a;
  --expo:cubic-bezier(.16,1,.3,1);--dark:#0a0a0a;
  --hero-bg-img:url('data:image/webp;base64,');
}
html{scroll-behavior:smooth;font-size:16px;overflow-x:hidden;}
