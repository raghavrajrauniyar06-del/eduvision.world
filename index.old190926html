/* Keep the chat toggle button always clear of the fab-dock (Call/WhatsApp/Apply),
   regardless of how many buttons the dock has or how tall it renders. */
function positionChatToggleAboveFabDock(){
  const dock = document.getElementById('fabDock');
  const ct = document.getElementById('chatToggle');
  const cw = document.getElementById('chatWindow');
  if(!dock || !ct) return;
  const dockH = dock.offsetHeight;
  const gap = 34;
  const safeBottom = 'env(safe-area-inset-bottom,0px)';
  const toggleBottom = `calc(${dockH}px + ${gap}px + ${safeBottom})`;
  ct.style.bottom = toggleBottom;
  if(cw){
    const toggleH = ct.offsetHeight || 60;
    cw.style.bottom = `calc(${dockH}px + ${toggleH}px + ${gap + 12}px + ${safeBottom})`;
  }
}
