    chatInput.value='';
    chatInput.style.height='auto';
    handleUserInput(text);
  }

  chatSend.addEventListener('click', sendMessage);
  chatInput.addEventListener('keydown', e=>{
    if(e.key==='Enter' && !e.shiftKey){ e.preventDefault(); sendMessage(); }
  });
  chatInput.addEventListener('input', function(){
    this.style.height='auto';
    this.style.height = Math.min(this.scrollHeight, 80)+'px';
  });

  function openChat(){
    chatOpen = true;
    if(typeof positionChatToggleAboveFabDock === 'function') positionChatToggleAboveFabDock();
    chatWindow.classList.add('open');
    chatToggle.classList.add('active-chat');
    chatNotif.style.display='none';
    // Prevent page scroll — chat is a popup
    document.body.style.overflow = '';
    setTimeout(()=>{ try{ chatInput.focus(); }catch(e){} }, 300);
    // Start conversation if fresh
    if(chatBody.children.length === 0){
      setTimeout(()=>{
        addMsg(`👋 Hello! I am EduVision AI, your Career Assistant.\n\nI am here to help you choose the right course and guide you towards the best career opportunities! 🚀\n\nMay I know your name to get started? 😊`, true, ['I\'m Rahul', 'I\'m Priya', 'I\'m a student','Tell me about courses']);
      }, 400);
    }
  }

  function closeChat(){
    chatOpen = false;
    chatWindow.classList.remove('open');
    chatToggle.classList.remove('active-chat');
    document.body.style.overflow = '';
    chatSettingsPanel.classList.remove('open');
  }

  chatToggle.addEventListener('click',()=>{ chatOpen ? closeChat() : openChat(); });
  chatClose.addEventListener('click', closeChat);
  chatMinimize.addEventListener('click', closeChat);

  // Auto-open after 8 seconds with welcome notification
  setTimeout(()=>{
    if(!chatOpen){
      chatNotif.textContent='1';
      chatNotif.style.display='flex';
      // Show a small "bubble" hint
