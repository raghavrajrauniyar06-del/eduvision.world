.logo-edu{color:#fff;}
.logo-vision{background:linear-gradient(135deg,#f0c84a,#c9972a,#f0c84a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-size:200% auto;animation:vision-shine 3s linear 4.8s infinite;}
