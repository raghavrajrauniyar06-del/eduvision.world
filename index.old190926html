/* soft warm gold champagne scrim so background stays bright and gold */
#hero::after{content:'';position:absolute;inset:0;pointer-events:none;z-index:1;
  background:linear-gradient(100deg,rgba(20,16,11,.45) 0%,rgba(20,16,11,.25) 45%,transparent 80%);
}
