  // High-level page integration: Scroll and Filter based on text matching
  function detectCourseAndPageTriggers(text) {
    const lower = text.toLowerCase();
    const courses = Object.keys(courseDB);
    const matched = courses.find(c => lower.includes(c.toLowerCase()));
    
    if (matched) {
      const coursesSec = document.getElementById('courses');
      if (coursesSec) {
        coursesSec.scrollIntoView({ behavior: 'smooth', block: 'center' });
        const d = courseDB[matched];
        if (d) {
          const tab = document.querySelector(`.crs-tab[data-cat="${d.level}"]`);
          if (tab) tab.click();
        }
      }
    }
    
    // Auto-fill forms if phone/name mentioned in context
    const phoneMatch = text.match(/\d{10}/);
    if(phoneMatch) {
      const phone = phoneMatch[0];
      const formPhone = document.querySelector('input[name="phone"]');
      if(formPhone) formPhone.value = phone;
    }
  }

