/* ═══ NAVBAR ═══ */
nav{
  position:fixed;top:0;left:0;right:0;padding:0 clamp(20px,4vw,48px);height:clamp(54px,6vw,64px);
  display:flex;align-items:center;gap:32px;background:transparent;
  opacity:0;transform:translateY(-100%);
  transition:opacity .5s var(--ease-out),transform .5s var(--ease-out),background .6s ease-in-out,backdrop-filter .6s ease-in-out,-webkit-backdrop-filter .6s ease-in-out,box-shadow .6s ease-in-out,height .3s var(--ease-out);
}
nav.visible{opacity:1;transform:translateY(0);}
nav.scrolled{
  background:rgba(18,14,10,.84) !important;
  backdrop-filter:blur(20px) saturate(1.5) !important;
  -webkit-backdrop-filter:blur(20px) saturate(1.5) !important;
  border-bottom:1px solid rgba(212,175,55,.2) !important;
  box-shadow:0 8px 32px rgba(0,0,0,.3) !important;
}
.nav-logo{display:flex;align-items:center;text-decoration:none;flex-shrink:0;transition:transform .3s var(--ease-out);}
.nav-logo:hover{transform:scale(1.03);}
.nav-mark{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,#c9932a,#8a6015);display:flex;align-items:center;justify-content:center;font-size:1rem;box-shadow:0 4px 16px rgba(201,151,42,.3);}
.nav-brand{font-size:.95rem;font-weight:700;letter-spacing:.06em;color:#fff;text-transform:uppercase;}
.nav-brand b{color:var(--gold-2);}
.nav-links{display:flex;align-items:center;gap:4px;list-style:none;margin-left:auto;}
.nav-links a{padding:7px 14px;border-radius:8px;font-size:.85rem;font-weight:700;letter-spacing:.02em;color:#111111;text-decoration:none;transition:color .5s ease-in-out,background .3s;}
.nav-links a:hover{color:#000000;background:rgba(0,0,0,.08);}
nav.scrolled .nav-links a{color:#ffffff !important;}
nav.scrolled .nav-links a:hover{color:var(--gold-2) !important;background:rgba(255,255,255,.1);}
.nav-highlight-btn {
  background: linear-gradient(135deg, #fefce8, #fef9c3) !important;
  border: 1.5px solid #c9932a !important;
  color: #9a650d !important;
  font-weight: 800 !important;
  padding: 6px 16px !important;
  border-radius: 20px !important;
  box-shadow: 0 4px 16px rgba(201, 147, 42, 0.25) !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 6px !important;
  transition: all 0.3s ease !important;
}
.nav-highlight-btn::before {
  content: '🔔';
  font-size: 0.9rem;
  animation: ringBell 2.5s ease-in-out infinite;
}
.nav-highlight-btn:hover {
  background: linear-gradient(135deg, #c9932a, #8a6015) !important;
  color: #ffffff !important;
  border-color: #c9932a !important;
  box-shadow: 0 8px 24px rgba(201, 147, 42, 0.45) !important;
  transform: translateY(-2px) !important;
}
nav.scrolled .nav-highlight-btn {
  background: rgba(201, 147, 42, 0.25) !important;
  color: #fef08a !important;
  border-color: rgba(201, 147, 42, 0.6) !important;
}
nav.scrolled .nav-highlight-btn:hover {
  background: linear-gradient(135deg, #c9932a, #8a6015) !important;
  color: #ffffff !important;
}
@keyframes ringBell {
  0%, 100% { transform: rotate(0deg); }
  15% { transform: rotate(14deg); }
  30% { transform: rotate(-14deg); }
  45% { transform: rotate(10deg); }
  60% { transform: rotate(-10deg); }
  75% { transform: rotate(0deg); }
}
.nav-cta{padding:9px 22px;border-radius:10px;background:linear-gradient(135deg,#c9932a,#8a6015);color:#fff;font-size:.82rem;font-weight:700;text-decoration:none;letter-spacing:.06em;text-transform:uppercase;transition:all .28s;flex-shrink:0;box-shadow:0 4px 20px rgba(201,151,42,.28);white-space:nowrap;}
.nav-cta:hover{transform:translateY(-2px);box-shadow:0 8px 28px rgba(201,151,42,.45);}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;}
.hamburger span{display:block;width:22px;height:2px;background:var(--text);border-radius:2px;transition:all .3s;}
@media(max-width:900px){.nav-links{display:none;}.hamburger{display:flex;}nav{gap:16px;}}
@media(max-width:480px){.nav-cta{padding:8px 16px;font-size:.75rem;}}

#mobileNav{position:fixed;inset:0;z-index:9000;background:rgba(9,9,11,.97);backdrop-filter:blur(40px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;transform:translateX(100%);transition:transform .45s var(--snap);}
