<script>
/* ═══════════════════════════════════════════
   DEVICE DETECTION
═══════════════════════════════════════════ */
const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) || window.innerWidth < 768;
const isTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ═══════════════════════════════════════════
   INTRO PARTICLE CANVAS
═══════════════════════════════════════════ */
const canvas = document.getElementById('particleCanvas');
const ctx = canvas.getContext('2d');
let W, H, particles = [];
const PARTICLE_COUNT = isMobile ? 20 : 110;

function resize(){ W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
resize();
window.addEventListener('resize',  resize);

class Particle {
  constructor(){ this.reset(); }
  reset(){
    this.x = Math.random()*W; this.y = Math.random()*H;
    this.size = Math.random()*2.2+.4;
    this.vx = (Math.random()-.5)*.35; this.vy = (Math.random()-.5)*.35;
    this.alpha = Math.random()*.5+.1;
    this.color = Math.random()>.5 ? '201,151,42' : '79,142,247';
    this.life = 0; this.maxLife = 180+Math.random()*320;
  }
  update(){ this.x+=this.vx; this.y+=this.vy; this.life++; if(this.life>this.maxLife||this.x<0||this.x>W||this.y<0||this.y>H) this.reset(); }
  draw(){ ctx.save(); ctx.globalAlpha=this.alpha*(1-this.life/this.maxLife); ctx.beginPath(); ctx.arc(this.x,this.y,this.size,0,Math.PI*2); ctx.fillStyle=`rgba(${this.color},1)`; ctx.fill(); ctx.restore(); }
}
for(let i=0;i<PARTICLE_COUNT;i++) particles.push(new Particle());
let _pLast=0;
function animParticles(ts){
  if(document.getElementById('intro').style.display === 'none') return;
  if(document.hidden || (ts-_pLast < 16)) { requestAnimationFrame(animParticles); return; }
  _pLast=ts;
  ctx.clearRect(0,0,W,H);
  particles.forEach(p=>{p.update();p.draw();});
  requestAnimationFrame(animParticles);
}
animParticles();

/* ═══════════════════════════════════════════
   HERO 3D CANVAS
═══════════════════════════════════════════ */
(function(){
  const c = document.getElementById('heroCanvas');
  if(!c) return;
  const cx = c.getContext('2d');
  let cW, cH;
  function rz(){ cW = c.width = c.offsetWidth; cH = c.height = c.offsetHeight; }
  rz(); window.addEventListener('resize',  rz);

  const SHAPE_COUNT = isMobile ? 4 : 16;
  const shapes = [];

  class Shape3D {
    constructor(){
      this.x = Math.random()*cW; this.y = Math.random()*cH;
      this.z = Math.random()*400+100;
      this.baseZ = this.z;
      this.vx = (Math.random()-.5)*.3; this.vy = (Math.random()-.5)*.3;
      this.vz = (Math.random()-.5)*.5;
      this.rot = 0; this.rotSpeed = (Math.random()-.5)*.02;
      this.size = Math.random()*60+20;
      this.type = Math.floor(Math.random()*3); // 0=circle, 1=ring, 2=polygon
      this.sides = Math.floor(Math.random()*4)+3;
      this.col = Math.random()>.5 ? [201,151,42] : [79,142,247];
      this.alpha = Math.random()*.15+.04;
    }
    update(){
      this.x+=this.vx; this.y+=this.vy; this.z+=this.vz;
      this.rot+=this.rotSpeed;
      if(this.x<-100) this.x=cW+100;
      if(this.x>cW+100) this.x=-100;
      if(this.y<-100) this.y=cH+100;
      if(this.y>cH+100) this.y=-100;
      if(this.z<50||this.z>600) this.vz*=-1;
    }
    draw(){
      const scale = 300/(300+this.z);
      const s = this.size*scale;
      const [r,g,b] = this.col;
      const a = this.alpha*scale;
      cx.save();
      cx.translate(this.x, this.y);
      cx.rotate(this.rot);
      cx.globalAlpha = a;
      if(this.type===0){
        cx.beginPath(); cx.arc(0,0,s,0,Math.PI*2);
        cx.strokeStyle=`rgb(${r},${g},${b})`; cx.lineWidth=1.5*scale; cx.stroke();
      } else if(this.type===1){
        cx.beginPath(); cx.arc(0,0,s,0,Math.PI*2);
        cx.strokeStyle=`rgb(${r},${g},${b})`; cx.lineWidth=3*scale; cx.stroke();
        cx.beginPath(); cx.arc(0,0,s*.6,0,Math.PI*2);
        cx.lineWidth=1.5*scale; cx.stroke();
      } else {
        cx.beginPath();
        for(let i=0;i<this.sides;i++){
          const angle = (i/this.sides)*Math.PI*2;
          const px = Math.cos(angle)*s; const py = Math.sin(angle)*s;
          if(i===0) cx.moveTo(px,py); else cx.lineTo(px,py);
        }
        cx.closePath();
        cx.strokeStyle=`rgb(${r},${g},${b})`; cx.lineWidth=1.5*scale; cx.stroke();
      }
      cx.restore();
    }
  }

  if(!prefersReduced){
    for(let i=0;i<SHAPE_COUNT;i++) shapes.push(new Shape3D());
    let heroVisible = true;
    const heroSec = document.getElementById('hero');
    if (heroSec && window.IntersectionObserver) {
      new IntersectionObserver(entries => {
        heroVisible = entries[0].isIntersecting;
      }, { threshold: 0 }).observe(heroSec);
    }
    const HERO_FRAME_TIME = 1000/90; // cap redraws at 90fps
    let _heroLast = 0;
    (function loop(ts){
      requestAnimationFrame(loop);
      if(ts - _heroLast < HERO_FRAME_TIME) return;
      _heroLast = ts;
      if(heroVisible){
        cx.clearRect(0,0,cW,cH);
        shapes.forEach(s=>{s.update();s.draw();});
      }
    })();
  }
})();

/* ═══════════════════════════════════════════
   CUSTOM CURSOR
═══════════════════════════════════════════ */
if(!isTouch){
  const cur = document.getElementById('cursor');
  const ring = document.getElementById('cursor-ring');
  let mx=0,my=0,rx=0,ry=0;
  document.addEventListener('mousemove',e=>{
    mx=e.clientX; my=e.clientY;
    cur.style.left=mx+'px'; cur.style.top=my+'px';
  },{passive:true});
  function trackRing(){ rx+=(mx-rx)*.11; ry+=(my-ry)*.11; ring.style.transform=`translate(calc(${rx}px - 50%),calc(${ry}px - 50%))`; requestAnimationFrame(trackRing); }
  trackRing();
  document.addEventListener('mousedown',()=>document.body.classList.add('clicking'));
  document.addEventListener('mouseup',()=>document.body.classList.remove('clicking'));
  document.querySelectorAll('a,button,.svc-card,.why-card,.t-card,.cnt-card,.fcard,.about-item,.ci-item,.crs-card,.gallery-item').forEach(el=>{
    el.addEventListener('mouseenter',()=>document.body.classList.add('hovering'));
    el.addEventListener('mouseleave',()=>document.body.classList.remove('hovering'));
  });
}

/* ═══════════════════════════════════════════
   RIPPLE
═══════════════════════════════════════════ */
document.querySelectorAll('.btn-gold,.btn-outline,.btn-wa,.btn-counsel,.form-btn,.nav-cta,.fab').forEach(btn=>{
  btn.addEventListener('click',function(e){
    const r=document.createElement('span'); r.className='ripple';
    const rect=this.getBoundingClientRect();
    const size=Math.max(rect.width,rect.height)*2;
    r.style.cssText=`width:${size}px;height:${size}px;left:${e.clientX-rect.left-size/2}px;top:${e.clientY-rect.top-size/2}px;`;
    this.style.position='relative'; this.style.overflow='hidden';
    this.appendChild(r);
    setTimeout(()=>r.remove(),700);
  });
});

/* ═══════════════════════════════════════════
   SERVICE CARD GLOW
═══════════════════════════════════════════ */
if(!isTouch){
  /* Glow + 3D tilt are combined into a single rAF-scheduled update per
     card. Raw mousemove events on a fast mouse can fire far above the
     screen refresh rate; writing styles synchronously on every one of
     them causes needless style/layout churn. Instead we just record the
     latest pointer position and flush it once per animation frame. */
  document.querySelectorAll('.svc-card').forEach(card=>{
    let raf = null, lastX = 0, lastY = 0;
    card.addEventListener('mousemove',e=>{
      const rect=card.getBoundingClientRect();
      lastX = (e.clientX-rect.left)/rect.width*100;
      lastY = (e.clientY-rect.top)/rect.height*100;
      if(raf) return;
      raf = requestAnimationFrame(()=>{
        card.style.setProperty('--mx',lastX+'%');
        card.style.setProperty('--my',lastY+'%');
        raf = null;
      });
    },{passive:true});
  });

  /* 3D TILT */
  document.querySelectorAll('.fcard,.cnt-card,.svc-card,.t-card,.why-card').forEach(card=>{
    let raf = null, pendingX = 0, pendingY = 0;
    card.addEventListener('mousemove',e=>{
      const rect=card.getBoundingClientRect();
      pendingX=(e.clientX-rect.left)/rect.width-.5;
      pendingY=(e.clientY-rect.top)/rect.height-.5;
      if(raf) return;
      raf = requestAnimationFrame(()=>{
        card.style.transform=`perspective(700px) rotateY(${pendingX*14}deg) rotateX(${-pendingY*14}deg) scale(1.04) translateY(-10px)`;
        raf = null;
      });
    },{passive:true});
    card.addEventListener('mouseleave',()=>{card.style.transform='';});
  });
}

/* ═══════════════════════════════════════════
   INTRO SPARKS
═══════════════════════════════════════════ */
const introEl = document.getElementById('intro');
const sparkStyle = document.createElement('style');
sparkStyle.textContent='@keyframes spark-fly{0%{transform:translate(0,0) scale(1);opacity:1;}100%{transform:translate(var(--tx),var(--ty)) scale(0);opacity:0;}}';
