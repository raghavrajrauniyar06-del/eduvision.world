  setTimeout(triggerHeroCounters,1400);
}
function triggerHeroCounters(){
  document.querySelectorAll('.cnt-num[data-target]').forEach(el=>{
    if(el._counted)return; el._counted=true;
    const target=parseInt(el.dataset.target), suf=el.dataset.suf||'';
    // Show final value immediately, then do quick animation
    el.textContent = target.toLocaleString('en-IN') + suf;
    let v=0; const dur=1200, steps=60, step=Math.ceil(target/steps);
    const iv=setInterval(()=>{
      v+=step; if(v>=target){v=target;clearInterval(iv);}
      el.textContent=v.toLocaleString('en-IN')+suf;
    }, dur/steps);
  });
}

/* ═══════════════════════════════════════════
   SCROLL OBSERVER
═══════════════════════════════════════════ */
/* Premium staggered reveal observer */
const _revealEls = document.querySelectorAll('.reveal,.reveal-left,.reveal-right,.ru,.rl,.rr,.rs');
const iObs = new IntersectionObserver((entries)=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      // Stagger siblings in same parent
      const siblings = e.target.parentElement
        ? Array.from(e.target.parentElement.children).filter(el=>
            el.classList.contains('reveal')||el.classList.contains('reveal-left')||el.classList.contains('reveal-right')
          )
        : [];
      const idx = siblings.indexOf(e.target);
      const delay = Math.min(idx * 60, 360);
      setTimeout(()=>{ e.target.classList.add('in'); }, delay);
      iObs.unobserve(e.target);
    }
  });
},{threshold:0.06, rootMargin:'0px 0px -30px 0px'});

_revealEls.forEach(el=>{ iObs.observe(el); });

// Trigger visible-on-load elements immediately
requestAnimationFrame(()=>{
  _revealEls.forEach(el=>{
    const r=el.getBoundingClientRect();
    if(r.top < window.innerHeight*0.92) { el.classList.add('in'); iObs.unobserve(el); }
  });
});

