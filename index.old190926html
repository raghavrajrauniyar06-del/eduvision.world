.intro-tagline{margin-top:14px;font-size:clamp(.62rem,2.2vw,.92rem);letter-spacing:.38em;text-transform:uppercase;color:rgba(201,151,42,.8);font-weight:500;opacity:0;animation:fade-up .9s ease 4.2s both;}
