#particleCanvas{position:absolute;inset:0;pointer-events:none;z-index:1;}

.book-scene{
  perspective:2400px;
  width:min(400px,88vw);height:min(300px,66vw);
  position:relative;transform-style:preserve-3d;
  z-index:10;animation:scene-rise 1.1s cubic-bezier(.16,1,.3,1) .1s both;flex-shrink:0;
}
@keyframes scene-rise{from{opacity:0;transform:translateY(min(120px,20vh)) scale(.45);}to{opacity:1;transform:translateY(0) scale(1);}}
.book-body{
  width:100%;height:100%;transform-style:preserve-3d;
  animation:bk-land 1.5s cubic-bezier(.16,1,.3,1) .5s both,bk-hover 7s ease-in-out 3.2s infinite,bk-open 1.3s cubic-bezier(.16,1,.3,1) 1.9s both;
  position:relative;
}
@keyframes bk-land{0%{transform:rotateX(38deg) rotateY(-45deg) scale(.3);}55%{transform:rotateX(11deg) rotateY(-20deg) scale(1.07);}100%{transform:rotateX(11deg) rotateY(-20deg) scale(1);}}
@keyframes bk-hover{0%,100%{transform:rotateX(11deg) rotateY(-20deg) translateY(0);}50%{transform:rotateX(8deg) rotateY(-15deg) translateY(min(-20px,-2.5vh));}}
@keyframes bk-open{0%{transform:rotateX(11deg) rotateY(-20deg);}50%{transform:rotateX(6deg) rotateY(10deg) scale(1.09);}100%{transform:rotateX(7deg) rotateY(7deg);}}
.book-cover{
  position:absolute;inset:0;
  background:linear-gradient(148deg,#162f96 0%,#091e6a 40%,#030e38 100%);
  border-radius:4px 20px 20px 4px;
  border:1px solid rgba(201,151,42,.4);
  box-shadow:0 min(70px,10vw) min(130px,18vw) rgba(0,0,0,.95),0 20px 50px rgba(0,0,0,.7),inset 0 1px 0 rgba(255,255,255,.12),inset 0 0 60px rgba(201,151,42,.05),0 0 90px rgba(201,151,42,.14);
  overflow:hidden;
}
.book-cover::before{content:'';position:absolute;inset:0;background:linear-gradient(118deg,transparent 25%,rgba(255,255,255,.07) 50%,transparent 75%);animation:cover-shimmer 3.8s ease 2.2s infinite;}
@keyframes cover-shimmer{0%{transform:translateX(-150%);}65%,100%{transform:translateX(250%);}}
.book-cover::after{content:'';position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 20px,rgba(255,255,255,.016) 20px,rgba(255,255,255,.016) 21px);}
.book-spine{position:absolute;left:calc(-7% - 1px);top:5px;bottom:5px;width:7%;background:linear-gradient(90deg,#030b20,#0a1840,#050e28);border-radius:4px 0 0 4px;border:1px solid rgba(201,151,42,.18);box-shadow:-5px 0 28px rgba(0,0,0,.7);}
.book-pages{position:absolute;top:6px;bottom:6px;left:9px;right:9px;border-radius:2px 8px 8px 2px;overflow:hidden;}
.book-pages::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,#faf6ee,#ede3d0);}
.book-pages::after{content:'';position:absolute;top:0;bottom:0;left:-3px;width:6px;background:linear-gradient(90deg,#b0a692,#d5cbba,#c4bb9e);border-radius:1px 0 0 1px;}
.page-lines{position:absolute;inset:0;background:repeating-linear-gradient(180deg,transparent,transparent 12px,rgba(0,0,0,.04) 12px,rgba(0,0,0,.04) 13px);animation:page-reveal 2.4s ease 2s both;}
@keyframes page-reveal{0%{clip-path:inset(0 100% 0 0);}100%{clip-path:inset(0 0% 0 0);}}
.book-inner-glow{position:absolute;top:6px;bottom:6px;left:9px;right:9px;background:linear-gradient(90deg,rgba(255,230,100,.6),rgba(201,151,42,.28),transparent);border-radius:2px;z-index:4;pointer-events:none;opacity:0;animation:inner-glow 2s ease 2.1s both;}
@keyframes inner-glow{0%{opacity:0;transform:scaleX(0);transform-origin:left;}35%{opacity:1;}100%{opacity:0;transform:scaleX(1);}}
.book-flap{position:absolute;top:-8px;bottom:-8px;left:-6px;right:50%;background:linear-gradient(148deg,#1e3699 0%,#0e2170 45%,#06133f 100%);border-radius:6px 0 0 6px;border:1px solid rgba(201,151,42,.3);transform-origin:right center;animation:flap-open 1.9s cubic-bezier(.16,1,.3,1) 2s both;z-index:6;backface-visibility:hidden;box-shadow:-18px 0 55px rgba(0,0,0,.75),inset 1px 0 0 rgba(255,255,255,.06);overflow:hidden;}
.book-flap::before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 24px,rgba(255,255,255,.02) 24px,rgba(255,255,255,.02) 25px);}
@keyframes flap-open{0%{transform:rotateY(0deg);}28%{transform:rotateY(-55deg);}65%{transform:rotateY(-138deg);}100%{transform:rotateY(-162deg);}}
.book-emboss{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;width:82%;opacity:0;animation:emboss-in 1s ease 1s both;display:flex;flex-direction:column;align-items:center;gap:4px;}
@keyframes emboss-in{from{opacity:0;transform:translate(-50%,-58%) scale(.55);}to{opacity:1;transform:translate(-50%,-50%) scale(1);}}
.emboss-logo-svg{width:min(120px,30vw);height:auto;filter:drop-shadow(0 0 14px rgba(201,151,42,.7)) drop-shadow(0 0 30px rgba(201,151,42,.35));animation:logo-pulse 2.5s ease-in-out 2.5s infinite;}
@keyframes logo-pulse{0%,100%{filter:drop-shadow(0 0 14px rgba(201,151,42,.7));}50%{filter:drop-shadow(0 0 28px rgba(201,151,42,.95)) drop-shadow(0 0 55px rgba(201,151,42,.5));}}
.emboss-name{font-family:'Cormorant Garamond',serif;font-size:clamp(.55rem,.9vw + .4rem,1rem);font-weight:700;letter-spacing:.22em;background:linear-gradient(135deg,#ffe58a,#c9972a,#ffe58a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-size:200% auto;animation:name-shine 3s linear 3s infinite;}
@keyframes name-shine{to{background-position:200% center;}}
.emboss-sub{font-size:clamp(.42rem,.6vw + .3rem,.62rem);letter-spacing:.3em;color:rgba(201,151,42,.6);font-family:'DM Sans',sans-serif;font-weight:600;text-transform:uppercase;}
.book-light-burst{position:absolute;left:50%;top:50%;width:min(1100px,180vw);height:min(1100px,180vw);border-radius:50%;background:radial-gradient(circle,rgba(255,228,100,.55) 0%,rgba(201,151,42,.3) 8%,rgba(201,147,42,.12) 28%,transparent 62%);transform:translate(-50%,-50%) scale(0);opacity:0;animation:light-burst 2.2s cubic-bezier(.16,1,.3,1) 2.2s both;pointer-events:none;z-index:2;mix-blend-mode:screen;}
@keyframes light-burst{0%{transform:translate(-50%,-50%) scale(0);opacity:0;}22%{opacity:.9;}100%{transform:translate(-50%,-50%) scale(1.7);opacity:0;}}
.page-rays{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);opacity:0;animation:rays-appear .8s ease 2.1s both;z-index:3;pointer-events:none;}
.ray{position:absolute;background:linear-gradient(to top,rgba(255,220,70,.55),rgba(201,151,42,.2),transparent);border-radius:200px;transform-origin:bottom center;animation:ray-breathe 2.8s ease-in-out infinite;bottom:0;}
.ray:nth-child(1){width:3px;height:min(280px,40vh);left:-70px;transform:rotate(-28deg);animation-delay:2.2s;}
