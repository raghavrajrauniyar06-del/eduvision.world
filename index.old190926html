/* ═══ HERO ═══ */
/* ═══ HERO (Warm Beige & Champagne Gold Luxury) ═══ */
#hero{
  min-height:100svh;padding:0;display:flex;align-items:center;position:relative;overflow:hidden;
  background-color:#14100b;
}
#hero::before{content:'';position:absolute;inset:0;width:100%;height:100%;left:0;top:0;transform:none;z-index:0;pointer-events:none;
  background-image:url('champagne_hero_bg.jpg');
  background-size:cover;
  background-position:center center;
  background-repeat:no-repeat;
  transform-origin:center center;
  animation:hero-bg-live 25s ease-in-out infinite;
  will-change:transform;
}
@keyframes hero-bg-live{
  0%{transform:scale(1);}
  50%{transform:scale(1.04);}
  100%{transform:scale(1);}
}
