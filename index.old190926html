function spawnSparks(count){
  if(prefersReduced) return;
  const colors=['#c9972a','#f0c84a','#4f8ef7','#ffffff','#ffd700','#a8d0ff'];
  const n = isMobile ? Math.floor(count*.5) : count;
  for(let i=0;i<n;i++){
    const s=document.createElement('div');
    const size=Math.random()*5+1.5;
    const spread = Math.min(window.innerWidth*.45,420);
    const tx=(Math.random()-.5)*spread*2;
    const ty=-(Math.random()*Math.min(460,window.innerHeight*.55)+80);
    s.style.cssText=`position:absolute;border-radius:50%;pointer-events:none;z-index:25;width:${size}px;height:${size}px;left:calc(50% + ${(Math.random()-.5)*60}px);top:calc(50% + ${(Math.random()-.5)*60}px);background:${colors[Math.floor(Math.random()*colors.length)]};box-shadow:0 0 ${size*2}px ${colors[Math.floor(Math.random()*colors.length)]};animation:spark-fly ${.8+Math.random()*1.6}s cubic-bezier(.16,1,.3,1) ${Math.random()*.4}s both;--tx:${tx}px;--ty:${ty}px;`;
