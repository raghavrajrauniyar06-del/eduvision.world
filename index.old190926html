(function(){
  const csInput=document.getElementById('courseSearchInput');
  const csResults=document.getElementById('courseSearchResults');
  const csResultsInner=document.getElementById('courseSearchResultsInner');
  const csWrap=document.getElementById('courseSearchWrap');
  const csClear=document.getElementById('gsearchClear');
  if(!csInput||!csResults||!csResultsInner||!csWrap||!csClear) return;

  const POPULAR=['MBA','Nursing','B.Ed','BCA','Artificial Intelligence','Digital Marketing'].filter(n=>courseDB[n]);
  let activeIndex=-1;
  let mode='popular'; // 'popular' | 'results' | 'empty'
  let debounceTimer=null;

  function escapeHtml(s){
    return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }
  function escapeRegex(s){ return s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'); }
  function highlight(text,q){
    if(!q) return escapeHtml(text);
    const esc=escapeHtml(text);
    const re=new RegExp('('+escapeRegex(escapeHtml(q))+')','ig');
    return esc.replace(re,'<mark>$1</mark>');
  }

  function itemsList(){
    return Array.from(csResults.querySelectorAll('.gsearch-item, .gsearch-chip'));
  }

  function setActive(i){
    const items=itemsList();
    items.forEach(el=>{ el.classList.remove('active'); el.removeAttribute('id'); });
    activeIndex = items.length ? ((i % items.length)+items.length)%items.length : -1;
    if(activeIndex>-1){
      const el=items[activeIndex];
      el.classList.add('active');
      el.id='gsopt-active';
      csInput.setAttribute('aria-activedescendant','gsopt-active');
      el.scrollIntoView({block:'nearest'});
    } else {
      csInput.removeAttribute('aria-activedescendant');
    }
  }

  function renderPopular(){
    mode='popular';
    csResultsInner.innerHTML =
      '<div class="gsearch-section-label">Popular Searches</div>'+
      '<div class="gsearch-chips">'+
        POPULAR.map((name,i)=>{
          const d=courseDB[name];
          return `<button type="button" class="gsearch-chip" style="--i:${i}" data-course="${encodeURIComponent(name)}" role="option">${d.icon} ${escapeHtml(name)}</button>`;
        }).join('')+
      '</div>';
    activeIndex=-1;
    open();
  }

  function renderResults(query){
    const q=query.trim().toLowerCase();
    const matches=Object.entries(courseDB).filter(([name,d])=>{
      const haystack=[name,d.level,d.mode,...(d.hl||[])].join(' ').toLowerCase();
      return haystack.includes(q);
    }).slice(0,6);

    if(!matches.length){
      mode='empty';
      csResultsInner.innerHTML = `
        <div class="gsearch-empty">
          <div class="gsearch-empty-icon">🔍</div>
          <div class="gsearch-empty-title">No course found for "${escapeHtml(query)}"</div>
          <div class="gsearch-empty-sub">Try a different keyword, or browse programs by category below.</div>
        </div>`;
      activeIndex=-1;
      open();
      return;
    }

    mode='results';
    csResultsInner.innerHTML =
      '<div class="gsearch-section-label">Suggestions</div>'+
      matches.map(([name,d],i)=>
        `<button type="button" class="gsearch-item" style="--i:${i}" data-course="${encodeURIComponent(name)}" role="option">
          <span class="gsearch-item-icon">${d.icon}</span>
          <span class="gsearch-item-body">
            <span class="gsearch-item-name">${highlight(name,query.trim())}</span>
            <span class="gsearch-item-meta">${escapeHtml(d.duration||d.mode||'')}</span>
          </span>
          <span class="gsearch-item-level">${escapeHtml(d.level)}</span>
        </button>`).join('');
    activeIndex=-1;
    open();
  }

  const csSection=document.getElementById('courses');
  function open(){
    csResults.classList.add('show');
    csInput.setAttribute('aria-expanded','true');
    if(csSection) csSection.classList.add('search-open');
  }
  function close(){
    csResults.classList.remove('show');
    csInput.setAttribute('aria-expanded','false');
    csInput.removeAttribute('aria-activedescendant');
    activeIndex=-1;
    if(csSection) csSection.classList.remove('search-open');
  }
  function syncClear(){
    csClear.classList.toggle('show', csInput.value.length>0);
  }
  function selectCourse(name){
    csInput.value='';
    syncClear();
    close();
    csResultsInner.innerHTML='';
    const url = 'course-details.html?course=' + encodeURIComponent(name);
    window.open(url, '_blank');
  }
  function activateCurrent(){
    const items=itemsList();
    const el = activeIndex>-1 ? items[activeIndex] : items[0];
    if(el) selectCourse(decodeURIComponent(el.dataset.course));
  }

  csInput.addEventListener('input',e=>{
    syncClear();
    clearTimeout(debounceTimer);
    const val=e.target.value;
    debounceTimer=setTimeout(()=>{
      if(!val.trim()) renderPopular(); else renderResults(val);
    },110);
  });

  csInput.addEventListener('focus',()=>{
    if(!csInput.value.trim()) renderPopular(); else renderResults(csInput.value);
  });

  csClear.addEventListener('click',()=>{
    csInput.value='';
    syncClear();
    renderPopular();
    csInput.focus();
  });

  csResults.addEventListener('click',e=>{
    const item=e.target.closest('.gsearch-item, .gsearch-chip');
    if(!item) return;
    selectCourse(decodeURIComponent(item.dataset.course));
  });

  csInput.addEventListener('keydown',e=>{
    if(e.key==='Escape'){
      if(csResults.classList.contains('show')){ close(); }
      else { csInput.value=''; syncClear(); csInput.blur(); }
      return;
    }
    if(e.key==='ArrowDown'){ e.preventDefault(); if(!csResults.classList.contains('show')){ if(!csInput.value.trim()) renderPopular(); else renderResults(csInput.value); } setActive(activeIndex+1); return; }
    if(e.key==='ArrowUp'){ e.preventDefault(); if(csResults.classList.contains('show')) setActive(activeIndex-1); return; }
    if(e.key==='Enter'){ e.preventDefault(); if(mode!=='empty' && csResults.classList.contains('show')) activateCurrent(); return; }
  });

  document.addEventListener('click',e=>{ if(!csWrap.contains(e.target)) close(); });
})();

