/* ═══ SECTION COMMON ═══ */
section{padding:var(--section-y) 0;position:relative;}
.container{width:var(--container);margin:0 auto;padding:0 clamp(18px,5vw,24px);box-sizing:border-box;}
.section-label{display:inline-flex;align-items:center;gap:8px;font-size:.68rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin-bottom:16px;}
.section-label::before{content:'';width:24px;height:1px;background:var(--gold);}
.section-heading{font-family:'Cormorant Garamond',serif;font-size:clamp(2rem,4.5vw,3.8rem);font-weight:700;line-height:1.05;letter-spacing:-.02em;color:#fff;margin-bottom:16px;}
