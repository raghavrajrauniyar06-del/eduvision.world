}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,6vw,80px);align-items:center;}
@media(max-width:768px){.about-grid{grid-template-columns:1fr!important;gap:32px!important;}}
.about-ceo-card{background:var(--surface);border:1px solid var(--border);border-radius:24px;padding:clamp(28px,4vw,40px);position:relative;overflow:hidden;}
.about-ceo-card::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 30% 0%,rgba(212,160,23,.07),transparent 60%);pointer-events:none;}
.about-ceo-top{display:flex;align-items:center;gap:16px;margin-bottom:24px;position:relative;z-index:1;}
.about-ceo-ava{width:60px;height:60px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,#c9932a,#8a6015);display:flex;align-items:center;justify-content:center;font-size:1.5rem;box-shadow:0 6px 24px rgba(201,151,42,.35);}
.about-ceo-name{font-size:1rem;font-weight:800;color:#fff;margin-bottom:2px;}
.about-ceo-role{font-size:.72rem;color:var(--muted);}
.about-ceo-quote{font-family:'Cormorant Garamond',serif;font-size:1.15rem;font-weight:600;font-style:italic;color:var(--text);line-height:1.6;margin-bottom:20px;border-left:2px solid var(--gold);padding-left:16px;position:relative;z-index:1;}
.about-ceo-stats{display:grid;grid-template-columns:1fr 1fr;gap:12px;position:relative;z-index:1;}
.about-mini-stat{padding:12px 14px;border-radius:12px;background:rgba(255,255,255,.04);border:1px solid var(--border);}
.about-mini-num{font-size:1.5rem;font-weight:800;color:#fff;line-height:1;}
.about-mini-lbl{font-size:.68rem;color:var(--muted);margin-top:3px;}
.about-items{display:flex;flex-direction:column;gap:20px;margin-top:32px;}
.about-item{display:flex;gap:16px;align-items:flex-start;padding:20px;border-radius:16px;background:rgba(255,255,255,.03);border:1px solid var(--border);transition:all .3s;}
.about-item:hover{background:rgba(255,255,255,.06);border-color:rgba(201,151,42,.15);}
.about-item-ico{width:40px;height:40px;border-radius:10px;flex-shrink:0;background:rgba(201,151,42,.1);display:flex;align-items:center;justify-content:center;font-size:1.1rem;}
.about-item-title{font-size:.9rem;font-weight:700;color:#fff;margin-bottom:4px;}
.about-item-text{font-size:.82rem;color:var(--muted);line-height:1.65;}

/* ═══ SERVICES ═══ */
#services{
  background:
    radial-gradient(ellipse 55% 45% at 88% 12%,rgba(90,130,200,.05),transparent 70%),
    linear-gradient(180deg,#08080f 0%,#0c0d11 45%,#0b0c10 100%);
  border-top:1px solid rgba(140,150,200,.05);border-bottom:1px solid rgba(140,150,200,.05);
}
.services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(16px,2.5vw,24px);margin-top:48px;}
@media(max-width:900px){.services-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:560px){.services-grid{grid-template-columns:1fr;}}
.svc-card{padding:clamp(24px,3.5vw,36px);border-radius:20px;background:var(--bg);border:1px solid var(--border);transition:all .38s var(--ease-out);position:relative;overflow:hidden;cursor:default;}
.svc-card::before{content:'';position:absolute;inset:0;border-radius:20px;background:radial-gradient(circle at 30% 20%,rgba(201,151,42,.08),transparent 55%);opacity:0;transition:opacity .35s;}
.svc-card:hover{transform:translateY(-8px);border-color:rgba(201,151,42,.22);box-shadow:0 20px 50px rgba(0,0,0,.4);}
.svc-card:hover::before{opacity:1;}
.svc-icon{width:52px;height:52px;border-radius:14px;background:rgba(201,151,42,.1);border:1px solid rgba(201,151,42,.18);display:flex;align-items:center;justify-content:center;font-size:1.4rem;margin-bottom:20px;transition:transform .35s var(--spring);position:relative;z-index:1;}
.svc-card:hover .svc-icon{transform:scale(1.1) rotate(-5deg);}
.svc-title{font-size:1rem;font-weight:700;color:#fff;margin-bottom:10px;position:relative;z-index:1;}
.svc-body{font-size:.83rem;color:var(--muted);line-height:1.7;position:relative;z-index:1;}
.svc-arrow{margin-top:20px;font-size:.78rem;font-weight:700;color:var(--gold);letter-spacing:.06em;text-transform:uppercase;display:inline-flex;align-items:center;gap:6px;transition:gap .25s;position:relative;z-index:1;}
.svc-card:hover .svc-arrow{gap:10px;}

/* ═══ WHY ═══ */
#why{
  background:
    radial-gradient(ellipse 45% 40% at 12% 85%,rgba(201,147,42,.035),transparent 70%),
    linear-gradient(180deg,#0b0c10 0%,#0a0b14 55%,#0a0c16 100%);
}
.why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(16px,2vw,24px);margin-top:48px;}
@media(max-width:900px){.why-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:480px){.why-grid{grid-template-columns:1fr;}}
.why-card{padding:clamp(24px,3vw,32px);border-radius:18px;border:1px solid var(--border);background:var(--surface);transition:all .35s;}
.why-card:hover{transform:translateY(-6px);border-color:rgba(201,147,42,.3);box-shadow:0 16px 40px rgba(0,0,0,.35);}
.why-num{font-family:'Cormorant Garamond',serif;font-size:2.8rem;font-weight:700;background:linear-gradient(135deg,var(--gold-2),#e8b42a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:8px;line-height:1;}
.why-title{font-size:.92rem;font-weight:700;color:#fff;margin-bottom:8px;}
.why-text{font-size:.8rem;color:var(--muted);line-height:1.65;}

/* ═══ TESTIMONIALS ═══ */
#testimonials{
  background:
    radial-gradient(ellipse 60% 45% at 50% 0%,rgba(160,180,255,.045),transparent 70%),
    linear-gradient(180deg,#090b14 0%,#080910 55%,#08090f 100%);
  overflow:hidden;border-top:1px solid rgba(140,150,200,.05);border-bottom:1px solid rgba(140,150,200,.05);
}
.testi-track-wrap{overflow:hidden;position:relative;margin-top:48px;}
.testi-track-wrap::before,.testi-track-wrap::after{content:'';position:absolute;top:0;bottom:0;width:100px;z-index:2;pointer-events:none;}
.testi-track-wrap::before{left:0;background:linear-gradient(90deg,var(--surface),transparent);}
.testi-track-wrap::after{right:0;background:linear-gradient(-90deg,var(--surface),transparent);}
#testiTrack{display:flex;gap:18px;width:max-content;animation:testi-scroll 55s linear infinite;padding:8px 0;}
#testiTrack:hover{animation-play-state:paused;}
@keyframes testi-scroll{from{transform:translateX(0);}to{transform:translateX(-50%);}}
.t-card{flex-shrink:0;width:clamp(280px,36vw,360px);background:var(--bg);border:1px solid var(--border);border-radius:20px;padding:clamp(20px,3vw,28px);transition:border-color .3s,box-shadow .3s;}
.t-card:hover{border-color:rgba(201,151,42,.22);box-shadow:0 12px 40px rgba(0,0,0,.35);}
.t-stars{color:var(--gold-2);font-size:1rem;letter-spacing:2px;margin-bottom:14px;}
.t-quote{font-family:'Cormorant Garamond',serif;font-size:4rem;line-height:.6;color:var(--gold);opacity:.25;margin-bottom:8px;}
.t-text{font-size:.84rem;color:var(--muted);line-height:1.7;margin-bottom:20px;}
.t-author{display:flex;align-items:center;gap:12px;}
.t-av{width:38px;height:38px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,#c9932a,#a07020);display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:800;color:#fff;}
.t-name{font-size:.84rem;font-weight:700;color:#fff;}
.t-role{font-size:.7rem;color:var(--muted);margin-top:1px;}

/* ═══ COUNSELLING FORM ═══ */
#counselling{
  background:
    radial-gradient(ellipse 50% 40% at 85% 20%,rgba(100,110,190,.04),transparent 70%),
    linear-gradient(180deg,#08090f 0%,#07080d 50%,#07070c 100%);
}
.counsel-grid{display:grid;grid-template-columns:1fr 420px;gap:clamp(40px,6vw,80px);align-items:start;}
@media(max-width:900px){.counsel-grid{grid-template-columns:1fr;}}
.counsel-perks{display:flex;flex-direction:column;gap:14px;margin-top:32px;}
.counsel-perk{display:flex;align-items:center;gap:12px;font-size:.85rem;color:var(--muted);}
.counsel-perk-ico{width:34px;height:34px;border-radius:9px;flex-shrink:0;background:rgba(201,151,42,.1);display:flex;align-items:center;justify-content:center;font-size:.95rem;}
.counsel-form-card{background:var(--surface);border:1px solid var(--border);border-radius:24px;padding:clamp(24px,4vw,36px);}
.fgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
@media(max-width:500px){.fgrid{grid-template-columns:1fr;}}
.ff{position:relative;}
.ff.full{grid-column:1/-1;}
.ff label{display:block;font-size:.68rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(201,151,42,.7);margin-bottom:6px;}
.ff input,.ff select,.ff textarea{width:100%;box-sizing:border-box;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;color:var(--text);font-size:.85rem;font-family:'DM Sans',sans-serif;padding:12px 16px;outline:none;transition:border .3s,box-shadow .3s;-webkit-appearance:none;}
.ff select option{background:var(--surface);color:var(--text);}
.ff textarea{resize:vertical;min-height:80px;}
.ff input::placeholder,.ff textarea::placeholder{color:rgba(255,255,255,.22);}
.ff input:focus,.ff select:focus,.ff textarea:focus{border-color:rgba(201,151,42,.6);box-shadow:0 0 0 3px rgba(201,151,42,.1);}
.form-btn{grid-column:1/-1;padding:15px;border-radius:14px;border:none;cursor:pointer;background:linear-gradient(135deg,#c9932a,#a0741c);color:#fff;font-size:.88rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-family:'DM Sans',sans-serif;transition:all .3s;box-shadow:0 6px 28px rgba(201,151,42,.3);position:relative;overflow:hidden;}
.form-btn::before{content:'';position:absolute;inset:0;background:linear-gradient(120deg,transparent 30%,rgba(255,255,255,.2) 50%,transparent 70%);transform:translateX(-150%);transition:transform .5s;}
.form-btn:hover::before{transform:translateX(150%);}
.form-btn:hover{transform:translateY(-3px);box-shadow:0 12px 40px rgba(201,151,42,.45);}
.form-btn:disabled{opacity:.7;cursor:not-allowed;transform:none;}
.form-success{display:none;text-align:center;padding:40px 24px;}
.form-success-icon{font-size:3rem;display:block;margin-bottom:16px;}
.form-success h3{font-family:'Cormorant Garamond',serif;font-size:1.8rem;color:#fff;margin-bottom:8px;}
.form-success p{color:var(--muted);font-size:.85rem;line-height:1.65;}

/* ═══ FAQ ═══ */
#faq{
  background:linear-gradient(180deg,#07070c 0%,#06060a 100%);
  border-top:1px solid rgba(140,150,200,.04);
}
.faq-list{margin-top:48px;max-width:720px;margin-left:auto;margin-right:auto;}
.faq-item{border-bottom:1px solid var(--border);}
.faq-question{width:100%;text-align:left;background:none;border:none;padding:20px 0;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:.95rem;font-weight:600;color:var(--text);font-family:'DM Sans',sans-serif;transition:color .25s;}
.faq-question:hover{color:var(--gold-2);}
.faq-icon{width:26px;height:26px;border-radius:50%;flex-shrink:0;background:rgba(255,255,255,.06);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:.75rem;transition:all .3s;color:var(--muted);}
.faq-item.open .faq-icon{background:rgba(201,151,42,.15);border-color:rgba(201,151,42,.3);color:var(--gold);transform:rotate(45deg);}
.faq-item.open .faq-question{color:var(--gold-2);}
.faq-answer{max-height:0;overflow:hidden;transition:max-height .4s var(--ease-out),padding .4s;padding:0;font-size:.88rem;color:var(--muted);line-height:1.75;}
.faq-item.open .faq-answer{max-height:400px;padding-bottom:20px;}

/* ═══ CONTACT ═══ */
#contact{
  background:linear-gradient(180deg,#06060a 0%,#050508 100%);
}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,6vw,80px);align-items:start;margin-top:48px;}
@media(max-width:768px){.contact-grid{grid-template-columns:1fr;}}
.contact-info-items{display:flex;flex-direction:column;gap:16px;margin-top:8px;}
.ci-item{display:flex;align-items:center;gap:16px;padding:16px 20px;border-radius:14px;background:#ffffff;border:1px solid rgba(255,255,255,0.8);box-shadow:0 8px 24px rgba(0,0,0,0.15);transition:all .3s cubic-bezier(0.25, 1, 0.5, 1);cursor:default;position:relative;overflow:hidden;}
.ci-item:hover{border-color:rgba(201,147,42,.4);box-shadow:0 15px 40px rgba(0,0,0,0.3), 0 0 0 1px rgba(201,147,42,.2);transform:translateY(-4px);}
.ci-ico{width:42px;height:42px;border-radius:12px;flex-shrink:0;background:linear-gradient(135deg,rgba(201,147,42,.15),rgba(201,147,42,.05));border:1px solid rgba(201,147,42,.2);display:flex;align-items:center;justify-content:center;font-size:1.2rem;box-shadow:inset 0 2px 4px rgba(255,255,255,0.5);}
.ci-lbl{font-size:.68rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#4b5563;margin-bottom:2px;}
.ci-val{font-size:.9rem;font-weight:700;color:#111827;}
.ci-val a{color:#111827;text-decoration:none;transition:color .25s;}
.ci-val a:hover{color:#c9932a;}
.contact-map{border-radius:20px;overflow:hidden;border:1px solid var(--border);box-shadow:0 20px 50px rgba(0,0,0,.4);}
.contact-map iframe{display:block;width:100%;height:320px;border:none;filter:grayscale(.3) brightness(.7);}

/* ═══ FOOTER ═══ */
footer{
  background:
    radial-gradient(ellipse 70% 55% at 50% 0%,rgba(201,147,42,.055),transparent 65%),
    linear-gradient(180deg,#050508 0%,#030304 60%,#020203 100%);
  border-top:1px solid rgba(201,147,42,.08);padding:clamp(48px,8vw,80px) 0 clamp(24px,4vw,36px);
}
.ft-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:clamp(32px,4vw,56px);margin-bottom:clamp(40px,6vw,60px);}
@media(max-width:900px){.ft-grid{grid-template-columns:1fr 1fr;}}
@media(max-width:480px){.ft-grid{grid-template-columns:1fr;}}
.ft-brand{max-width:280px;}
.ft-logo-wrap{display:flex;align-items:center;gap:10px;margin-bottom:14px;}
.ft-logo-ico{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,#c9932a,#8a6015);display:flex;align-items:center;justify-content:center;font-size:.95rem;}
.ft-logo-name{font-size:.92rem;font-weight:700;letter-spacing:.06em;color:#fff;text-transform:uppercase;}
.ft-logo-name b{color:var(--gold-2);}
.ft-tagline{font-size:.8rem;color:var(--muted);line-height:1.65;margin-bottom:20px;}
.ft-socials{display:flex;gap:10px;}
.ft-soc{width:34px;height:34px;border-radius:9px;background:rgba(255,255,255,.06);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:.9rem;transition:all .25s;text-decoration:none;color:var(--text);}
.ft-soc:hover{background:rgba(201,151,42,.15);border-color:rgba(201,151,42,.3);transform:translateY(-2px);}
.ft-col-title{font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin-bottom:16px;}
.ft-links{list-style:none;display:flex;flex-direction:column;gap:8px;}
.ft-links li a{font-size:.82rem;color:var(--muted);text-decoration:none;transition:color .25s;}
.ft-links li a:hover{color:var(--text);}
.ft-bottom{border-top:1px solid var(--border);padding-top:clamp(20px,3vw,28px);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;}
.ft-copy{font-size:.75rem;color:rgba(255,255,255,.3);}
.ft-dev{font-size:.85rem;font-weight:700;letter-spacing:.06em;color:rgba(255,255,255,.5);text-transform:uppercase;}
.ft-dev span{background:linear-gradient(135deg,#f0b429,#fff0a8,#d4af37);-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-weight:900;opacity:1;text-shadow:0 2px 14px rgba(201,147,42,.4);letter-spacing:.08em;margin-left:4px;}

/* ═══ FAB DOCK ═══ */
.fab-dock{position:fixed;bottom:calc(28px + env(safe-area-inset-bottom,0px));right:28px;z-index:600;display:flex;flex-direction:column;gap:10px;align-items:flex-end;opacity:0;transform:translateY(24px);transition:all .6s var(--ease-out) 5.5s;}
.fab-dock.show{opacity:1;transform:translateY(0);}
.fab{display:inline-flex;align-items:center;gap:8px;padding:11px 20px;border-radius:99px;font-size:.78rem;font-weight:700;letter-spacing:.05em;text-decoration:none;transition:all .3s;box-shadow:0 6px 24px rgba(0,0,0,.35);position:relative;overflow:hidden;}
.fab-call{background:linear-gradient(135deg,var(--blue),#1540b0);color:#fff;}
.fab-call:hover{transform:translateY(-3px) scale(1.04);box-shadow:0 12px 32px rgba(201,147,42,.4);}
.fab-wa{background:linear-gradient(135deg,#25D366,#128C4A);color:#fff;}
.fab-wa:hover{transform:translateY(-3px) scale(1.04);box-shadow:0 12px 32px rgba(37,211,102,.45);}
.fab-apply{background:linear-gradient(135deg,var(--gold),#7a5000);color:#fff;}
.fab-apply:hover{transform:translateY(-3px) scale(1.04);box-shadow:0 12px 32px rgba(201,151,42,.4);}
.fab-text{font-weight:700;}
@media(max-width:767px){
  .fab-dock{bottom:calc(16px + env(safe-area-inset-bottom,0px));right:16px;gap:10px;}
  .fab-text{display:none;}
  .fab{width:46px;height:46px;padding:0;justify-content:center;font-size:1.2rem;border-radius:50%;}
}

/* ═══ APPLY NOW — PREMIUM ATTENTION EFFECT ═══ */
.apply-glow{position:relative;animation:apply-breathe 3.6s ease-in-out infinite;}
.apply-glow::after{
  content:'';position:absolute;inset:0;border-radius:inherit;pointer-events:none;
  background:linear-gradient(120deg,transparent 25%,rgba(255,255,255,.4) 48%,rgba(255,240,200,.55) 50%,rgba(255,255,255,.4) 52%,transparent 75%);
  background-size:250% 100%;background-position:250% 0;opacity:0;
  animation:apply-shimmer 4.8s ease-in-out infinite;
}
@keyframes apply-shimmer{
  0%,78%,100%{background-position:250% 0;opacity:0;}
  84%{opacity:.8;}
  94%{background-position:-60% 0;opacity:0;}
}
@keyframes apply-breathe{
  0%,100%{filter:drop-shadow(0 0 0 rgba(201,147,42,0));}
  50%{filter:drop-shadow(0 0 14px rgba(201,151,42,.5));}
}
.apply-glow:hover{filter:drop-shadow(0 0 20px rgba(201,151,42,.6));}
.apply-glow:active{transform:scale(.97);}

.ripple{position:absolute;border-radius:50%;background:rgba(255,255,255,.18);transform:scale(0);animation:ripple-expand .7s ease-out;pointer-events:none;}
@keyframes ripple-expand{to{transform:scale(1);opacity:0;}}



@media(max-width:767px){
  /* Kill GPU-heavy effects on mobile */
  .svc-card,.why-card,.t-card,.about-item,.ci-item,
  .counsel-form-card,.crs-card,.faq-item,.about-ceo-card{
    backdrop-filter:none!important;-webkit-backdrop-filter:none!important;
  }
  /* Mobile typography */
  .hero-title{font-size:clamp(2.4rem,10vw,3.2rem)!important;letter-spacing:-.02em;}
  .section-heading{font-size:clamp(1.8rem,7.5vw,2.8rem)!important;}
  /* Mobile hero layout */
  .hero-inner{grid-template-columns:1fr!important;gap:32px!important;text-align:center!important;padding-top:clamp(90px,18vh,130px)!important;padding-bottom:60px!important;}
  .hero-left{max-width:100%!important;}
  .hero-sub{max-width:100%!important;font-size:.92rem!important;}
  .hero-actions{justify-content:center!important;flex-direction:column!important;width:100%!important;gap:10px!important;}
  .btn-primary,.btn-ghost{width:100%!important;justify-content:center!important;min-height:52px!important;font-size:.9rem!important;}
  .hero-card{max-width:100%!important;margin:0!important;}
  /* Mobile grid fixes */
  .about-grid{grid-template-columns:1fr!important;gap:28px!important;}
  .services-grid{grid-template-columns:1fr!important;}
  .why-grid{grid-template-columns:1fr 1fr!important;gap:12px!important;}
  .ft-grid{grid-template-columns:1fr 1fr!important;}
  .counsel-grid{grid-template-columns:1fr!important;}
  .contact-grid{grid-template-columns:1fr!important;}
  /* Mobile padding */
  section{padding:clamp(60px,10vw,80px) 0!important;}
  .container{padding:0 clamp(16px,5vw,24px)!important;}
  /* Mobile nav */
  .nav-cta{display:none!important;}
  nav{padding:0 clamp(16px,5vw,20px)!important;}
  /* Mobile FAQ */
  .faq-question{font-size:.88rem!important;padding:16px 0!important;}
  .faq-list{padding:0!important;}
  /* Mobile footer */
  .ft-grid{grid-template-columns:1fr!important;}
  .ft-bottom{flex-direction:column!important;gap:8px!important;text-align:center!important;}
  /* Touch targets */
  .crs-tab{padding:8px 16px!important;font-size:.7rem!important;}
  .fab{padding:14px!important;}
}
@media(max-width:400px){
  .why-grid{grid-template-columns:1fr!important;}
  .hero-title{font-size:clamp(2rem,9vw,2.6rem)!important;}
  .section-heading{font-size:clamp(1.6rem,7vw,2rem)!important;}
}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important;}
}


#cModal{position:fixed;inset:0;z-index:99999;display:flex;align-items:flex-end;justify-content:center;pointer-events:none;padding:0;}
@media(min-width:600px){#cModal{align-items:center;padding:20px;}}
.cm-backdrop{position:absolute;inset:0;background:rgba(0,2,12,.55);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);opacity:0;transition:opacity .4s ease;}
@media(max-width:600px){.cm-backdrop{backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);}}
.cm-panel{position:relative;z-index:2;width:100%;max-width:min(660px,96vw);max-height:92vh;overflow-y:auto;overflow-x:hidden;border-radius:28px 28px 0 0;background:rgba(8,14,42,.88);backdrop-filter:blur(30px);-webkit-backdrop-filter:blur(30px);border:1px solid rgba(255,255,255,.13);border-bottom:none;box-shadow:0 -4px 60px rgba(0,0,0,.7),0 0 0 .5px rgba(255,255,255,.08),inset 0 1px 0 rgba(255,255,255,.12),0 0 120px rgba(201,151,42,.07);transform:translateY(110%);opacity:0;transition:transform .58s cubic-bezier(.16,1,.3,1),opacity .4s ease;scrollbar-width:none;}
@media(max-width:600px){.cm-panel{backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);}}
.cm-panel::-webkit-scrollbar{display:none;}
@media(min-width:600px){.cm-panel{border-radius:28px;border-bottom:1px solid rgba(255,255,255,.1);transform:scale(.7) translateY(60px);}}
#cModal.open{pointer-events:all;}
#cModal.open .cm-backdrop{opacity:1;}
#cModal.open .cm-panel{transform:translateY(0);opacity:1;}
@media(min-width:600px){#cModal.open .cm-panel{transform:scale(1) translateY(0);}}
#cModal.closing .cm-backdrop{opacity:0;transition-duration:.35s;}
#cModal.closing .cm-panel{transform:translateY(115%);opacity:0;transition:transform .42s cubic-bezier(.77,0,.18,1),opacity .35s ease;}
@media(min-width:600px){#cModal.closing .cm-panel{transform:scale(.65) translateY(50px);}}
.cm-handle{width:44px;height:5px;border-radius:99px;background:rgba(255,255,255,.2);margin:14px auto 0;}
.cm-hero{position:relative;height:190px;overflow:hidden;background:linear-gradient(145deg,#0d2280 0%,#06133f 60%,#020818 100%);flex-shrink:0;}
.cm-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(201,147,42,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(201,147,42,.07) 1px,transparent 1px);background-size:34px 34px;animation:cm-grid-move 14s linear infinite;}
@keyframes cm-grid-move{to{background-position:34px 34px;}}
.cm-orb{position:absolute;border-radius:50%;filter:blur(50px);pointer-events:none;}
.cm-orb.a{width:220px;height:220px;background:rgba(201,151,42,.25);top:-60px;right:-40px;animation:cm-oa 5s ease-in-out infinite;}
.cm-orb.b{width:180px;height:180px;background:rgba(201,147,42,.2);bottom:-50px;left:-30px;animation:cm-ob 7s ease-in-out infinite;}
@keyframes cm-oa{0%,100%{transform:translate(0,0) scale(1);}50%{transform:translate(-18px,14px) scale(1.1);}}
@keyframes cm-ob{0%,100%{transform:translate(0,0) scale(1);}50%{transform:translate(12px,-18px) scale(1.08);}}
#cmCanvas{position:absolute;inset:0;pointer-events:none;}
.cm-hero-inner{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;z-index:3;}
.cm-icon{font-size:clamp(3.2rem,8vw,4.5rem);display:block;animation:cm-icon-pop .55s cubic-bezier(.34,1.56,.64,1) .05s both;filter:drop-shadow(0 0 24px rgba(201,151,42,.65));}
@keyframes cm-icon-pop{from{transform:scale(0) rotate(-25deg);opacity:0;}to{transform:scale(1) rotate(0deg);opacity:1;}}
.cm-badge{background:rgba(201,151,42,.18);border:1px solid rgba(201,151,42,.45);color:var(--gold2);padding:5px 20px;border-radius:99px;font-size:.68rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;animation:cm-badge-in .5s cubic-bezier(.16,1,.3,1) .18s both;backdrop-filter:blur(10px);}
@keyframes cm-badge-in{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}
.cm-close{position:absolute;top:14px;right:14px;z-index:10;width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);color:rgba(255,255,255,.7);font-size:1rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .28s var(--spring);backdrop-filter:blur(10px);}
.cm-close:hover{background:rgba(255,60,60,.2);border-color:rgba(255,80,80,.4);color:#fff;transform:rotate(90deg) scale(1.1);}
.cm-body{padding:clamp(18px,4vw,32px) clamp(18px,5vw,36px) clamp(22px,5vw,40px);}
.cm-shimmer-line{height:1px;background:linear-gradient(90deg,transparent,var(--gold),var(--elec),var(--gold),transparent);background-size:300% auto;animation:cm-line-shine 3s linear infinite,cm-line-grow .6s cubic-bezier(.16,1,.3,1) .1s both;transform-origin:left;}
@keyframes cm-line-grow{from{transform:scaleX(0);}to{transform:scaleX(1);}}
@keyframes cm-line-shine{to{background-position:300% center;}}
.cm-title{font-family:'Cormorant Garamond',serif;font-size:clamp(1.7rem,5vw,2.5rem);font-weight:700;background:linear-gradient(135deg,#fff 20%,var(--gold2) 60%,#fff 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-size:200% auto;animation:cm-title-shine 4s linear 1s infinite,cm-title-in .5s cubic-bezier(.16,1,.3,1) .12s both;margin-bottom:5px;line-height:1.15;}
@keyframes cm-title-shine{to{background-position:200% center;}}
@keyframes cm-title-in{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}
.cm-sub{font-size:.78rem;color:var(--muted);letter-spacing:.06em;margin-bottom:22px;animation:cm-fade-up .45s ease .2s both;}
.cm-pills{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:22px;animation:cm-fade-up .45s ease .25s both;}
.cm-pill{display:flex;align-items:center;gap:7px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:99px;padding:7px 15px;font-size:.73rem;color:rgba(255,255,255,.65);transition:all .3s;}
.cm-pill:hover{background:rgba(201,151,42,.1);border-color:rgba(201,151,42,.35);color:var(--gold2);}
.cm-pill b{color:var(--gold2);font-weight:600;}
.cm-desc{font-size:.87rem;line-height:1.78;color:rgba(255,255,255,.6);margin-bottom:24px;animation:cm-fade-up .45s ease .3s both;}
.cm-highlights{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:28px;animation:cm-fade-up .45s ease .34s both;}
@media(max-width:460px){.cm-highlights{grid-template-columns:1fr;}}
.cm-hl{display:flex;align-items:flex-start;gap:9px;background:rgba(201,151,42,.05);border:1px solid rgba(201,151,42,.12);border-radius:12px;padding:11px 14px;font-size:.77rem;color:rgba(255,255,255,.65);transition:all .3s;}
.cm-hl:hover{background:rgba(201,151,42,.1);border-color:rgba(201,151,42,.28);transform:translateX(3px);}
.cm-hl-dot{width:18px;height:18px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,var(--gold),var(--elec));display:flex;align-items:center;justify-content:center;font-size:.6rem;color:#fff;font-weight:800;margin-top:1px;}
.cm-divider{height:1px;margin:0 0 26px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.1),transparent);animation:cm-fade-up .45s ease .36s both;}
.cm-form-hd{font-size:.95rem;font-weight:700;color:#fff;margin-bottom:18px;display:flex;align-items:center;gap:12px;animation:cm-fade-up .45s ease .38s both;}
.cm-form-hd-bar{flex:1;height:1px;background:linear-gradient(90deg,var(--gold),rgba(201,147,42,.3),transparent);}
.cm-form{display:grid;grid-template-columns:1fr 1fr;gap:14px;animation:cm-fade-up .45s ease .42s both;}
@media(max-width:460px){.cm-form{grid-template-columns:1fr;}}
.cm-field{position:relative;}
.cm-field.full{grid-column:1/-1;}
.cm-field label{display:block;font-size:.67rem;font-weight:700;color:rgba(201,151,42,.75);letter-spacing:.12em;text-transform:uppercase;margin-bottom:7px;}
.cm-field input,.cm-field select,.cm-field textarea{width:100%;box-sizing:border-box;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:14px;color:#fff;font-size:.84rem;font-family:'DM Sans',sans-serif;padding:13px 16px;outline:none;transition:border .3s,box-shadow .3s,background .3s;appearance:none;-webkit-appearance:none;backdrop-filter:blur(10px);}
.cm-field select option{background:#07122e;color:#fff;}
.cm-field textarea{resize:vertical;min-height:75px;}
.cm-field input::placeholder,.cm-field textarea::placeholder{color:rgba(255,255,255,.25);}
.cm-field input:focus,.cm-field select:focus,.cm-field textarea:focus{border-color:rgba(201,151,42,.7);background:rgba(201,151,42,.05);box-shadow:0 0 0 3px rgba(201,151,42,.12),0 0 24px rgba(201,151,42,.08);}
.cm-field::after{content:'';position:absolute;bottom:1px;left:16px;right:16px;height:2px;border-radius:0 0 14px 14px;background:linear-gradient(90deg,var(--gold),var(--elec));transform:scaleX(0);transition:transform .38s cubic-bezier(.16,1,.3,1);}
.cm-field:focus-within::after{transform:scaleX(1);}
.cm-submit{grid-column:1/-1;position:relative;overflow:hidden;padding:16px;border:none;border-radius:16px;cursor:pointer;background:linear-gradient(135deg,#c9972a 0%,#f0c84a 50%,#c9972a 100%);background-size:200% auto;color:#04091a;font-weight:800;font-size:.9rem;letter-spacing:.1em;text-transform:uppercase;font-family:'DM Sans',sans-serif;box-shadow:0 8px 32px rgba(201,151,42,.4);transition:all .35s;}
.cm-submit:hover{background-position:right center;transform:translateY(-4px);box-shadow:0 16px 50px rgba(201,151,42,.55);}
.cm-submit::before{content:'';position:absolute;inset:0;background:linear-gradient(120deg,transparent 30%,rgba(255,255,255,.3) 50%,transparent 70%);transform:translateX(-150%);transition:transform .5s;}
.cm-submit:hover::before{transform:translateX(160%);}
.cm-success{display:none;text-align:center;padding:36px 20px;animation:cm-success-pop .65s cubic-bezier(.34,1.56,.64,1) both;}
@keyframes cm-success-pop{from{transform:scale(.4);opacity:0;}to{transform:scale(1);opacity:1;}}
.cm-success-icon{font-size:4rem;display:block;margin-bottom:14px;animation:cm-spin-in .8s cubic-bezier(.34,1.56,.64,1) .1s both;}
@keyframes cm-spin-in{from{transform:rotate(-180deg) scale(0);}to{transform:rotate(0) scale(1);}}
.cm-success h3{font-family:'Cormorant Garamond',serif;font-size:1.9rem;color:#fff;margin-bottom:8px;}
.cm-success p{color:var(--muted);font-size:.85rem;line-height:1.65;}
.cm-wa{margin-top:18px;display:flex;align-items:center;gap:12px;background:rgba(37,211,102,.07);border:1px solid rgba(37,211,102,.2);border-radius:16px;padding:14px 18px;font-size:.78rem;color:rgba(255,255,255,.55);animation:cm-fade-up .45s ease .5s both;}
.cm-wa-btn{margin-left:auto;flex-shrink:0;background:linear-gradient(135deg,#25d366,#1da851);color:#fff;font-weight:800;font-size:.72rem;letter-spacing:.08em;border:none;border-radius:99px;padding:9px 20px;cursor:pointer;transition:all .28s;white-space:nowrap;}
.cm-wa-btn:hover{transform:translateY(-2px);box-shadow:0 8px 26px rgba(37,211,102,.45);}
@keyframes cm-fade-up{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);}}

/* ============================================================
   RAGHAV AI CHATBOT
============================================================ */
/* Chat Header */
.chat-hdr{
  padding:18px 20px;
  background:linear-gradient(135deg,rgba(7,18,46,.95),rgba(15,30,80,.9));
  border-bottom:1px solid rgba(255,255,255,.08);
  display:flex;align-items:center;gap:13px;
  position:relative;flex-shrink:0;
}
.chat-hdr::before{content:'';position:absolute;bottom:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--gold),var(--elec),transparent);}
.chat-avatar{
  width:44px;height:44px;border-radius:50%;flex-shrink:0;
  background:linear-gradient(135deg,var(--navy2),var(--elec));
  border:2px solid rgba(201,151,42,.4);
  display:flex;align-items:center;justify-content:center;
  font-size:1.3rem;position:relative;
}
.chat-status-dot{position:absolute;bottom:1px;right:1px;width:10px;height:10px;border-radius:50%;background:#22c55e;border:2px solid var(--dark);animation:status-blink 2s ease-in-out infinite;}
@keyframes status-blink{0%,100%{opacity:1;}50%{opacity:.6;}}
.chat-hdr-info{flex:1;}
.chat-hdr-name{font-weight:700;font-size:.95rem;color:#fff;}
.chat-hdr-sub{font-size:.72rem;color:var(--gold);margin-top:1px;}
.chat-hdr-close{background:none;border:none;color:var(--muted);font-size:1.1rem;cursor:pointer;padding:4px;border-radius:6px;transition:all .2s;}
.chat-hdr-close:hover{color:#fff;background:rgba(255,255,255,.08);}
.chat-hdr-minimize{background:none;border:none;color:var(--muted);font-size:1rem;cursor:pointer;padding:4px;border-radius:6px;transition:all .2s;}
.chat-hdr-minimize:hover{color:#fff;background:rgba(255,255,255,.08);}
.chat-hdr-settings{background:none;border:none;color:var(--muted);font-size:1rem;cursor:pointer;padding:4px;border-radius:6px;transition:all .3s var(--spring);margin-left:auto;display:flex;align-items:center;justify-content:center;}
.chat-hdr-settings:hover{color:#fff;background:rgba(255,255,255,.08);transform:rotate(45deg) scale(1.12);}

/* Settings Panel */
.chat-settings-panel {
  position:absolute;inset:0;background:rgba(9,9,11,0.98);z-index:710;
  display:flex;flex-direction:column;transform:translateX(100%);
  transition:transform 0.3s cubic-bezier(0.16,1,0.3,1);padding:20px;
}
.chat-settings-panel.open {transform:translateX(0);}
.settings-hdr {display:flex;justify-content:space-between;align-items:center;font-weight:800;color:var(--gold);border-bottom:1px solid rgba(255,255,255,0.1);padding-bottom:12px;margin-bottom:16px;}
.settings-close-btn {background:none;border:none;color:var(--muted);cursor:pointer;font-size:1.1rem;}
.settings-close-btn:hover {color:#fff;}
.settings-label {display:block;font-size:0.72rem;color:var(--muted);text-transform:uppercase;margin-bottom:6px;margin-top:10px;font-weight:700;}
.settings-select, .settings-input {width:100%;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:8px;color:#fff;padding:8px 10px;font-size:0.82rem;margin-bottom:10px;outline:none;}
.settings-select:focus, .settings-input:focus {border-color:var(--gold);}
.settings-hint {font-size:0.72rem;color:var(--muted);line-height:1.4;margin-bottom:8px;}
.settings-save-btn {width:100%;background:linear-gradient(135deg, var(--gold), #b37e1a);border:none;border-radius:8px;color:#fff;font-weight:bold;padding:10px;cursor:pointer;transition:opacity 0.2s;}
.settings-save-btn:hover {opacity:0.9;}

/* Chat Body */
.chat-body{
  flex:1;overflow-y:auto;padding:16px;
  display:flex;flex-direction:column;gap:14px;
  scrollbar-width:thin;scrollbar-color:rgba(201,151,42,.3) transparent;
}
.chat-body::-webkit-scrollbar{width:3px;}
.chat-body::-webkit-scrollbar-thumb{background:rgba(201,151,42,.3);border-radius:3px;}

/* Messages */
.msg{display:flex;gap:8px;align-items:flex-end;animation:msg-in .5s cubic-bezier(0.16,1,0.3,1) both;}
@keyframes msg-in{
  from{opacity:0;transform:translateY(20px) scale(0.94);filter:blur(4px);}
  to{opacity:1;transform:translateY(0) scale(1);filter:blur(0);}
}
.msg.bot{flex-direction:row;}
.msg.user{flex-direction:row-reverse;}
.msg-avatar{
  width:30px;height:30px;border-radius:50%;
  background:linear-gradient(135deg,var(--navy2),var(--elec));
  display:flex;align-items:center;justify-content:center;
  font-size:.82rem;flex-shrink:0;
  border:1px solid rgba(201,151,42,.4);
  box-shadow:0 0 10px rgba(201,151,42,.15);
  transition:transform .3s var(--spring);
}
.msg:hover .msg-avatar{transform:scale(1.08);}
.msg-bubble{
  max-width:75%;padding:11px 15px;border-radius:18px;
  font-size:.83rem;line-height:1.6;
  transition:box-shadow .3s;
}
.msg.bot .msg-bubble{
  background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.09);
  border-bottom-left-radius:4px;color:#dde3f5;
}
.msg.bot .msg-bubble:hover{
  box-shadow:0 4px 20px rgba(201,147,42,0.12);
}
.msg.user .msg-bubble{
  background:linear-gradient(135deg,rgba(201,151,42,.22),rgba(201,147,42,.14));
  border:1px solid rgba(201,151,42,.32);
  border-bottom-right-radius:4px;color:#fff;
}
.msg.user .msg-bubble:hover{
  box-shadow:0 4px 20px rgba(201,151,42,0.18);
}

/* Typing indicator */
.typing-indicator{display:flex;gap:8px;align-items:flex-end;animation:msg-in .5s cubic-bezier(0.16,1,0.3,1) both;}
.typing-bubble{
  background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);
  padding:10px 16px;border-radius:18px;border-bottom-left-radius:4px;
  display:flex;gap:6px;align-items:center;
  animation:typing-glow 2.4s ease-in-out infinite;
}
@keyframes typing-glow{
  0%,100%{box-shadow:0 0 0 0 rgba(201,147,42,0);}
  50%{box-shadow:0 0 14px 2px rgba(201,147,42,0.18);}
}
.typing-label{
  font-size:.68rem;color:rgba(255,255,255,.35);margin-right:4px;
  letter-spacing:.03em;font-style:italic;
  animation:label-pulse 1.8s ease-in-out infinite;
}
@keyframes label-pulse{0%,100%{opacity:.35;}50%{opacity:.7;}}
.typing-dot{
  width:7px;height:7px;border-radius:50%;
  background:linear-gradient(135deg,rgba(201,147,42,.8),rgba(201,151,42,.6));
  animation:typing-bounce 1.3s cubic-bezier(0.4,0,0.6,1) infinite;
}
.typing-dot:nth-child(2){animation-delay:.18s;}
.typing-dot:nth-child(3){animation-delay:.36s;}
@keyframes typing-bounce{
  0%,70%,100%{transform:translateY(0) scale(1);opacity:.7;}
  35%{transform:translateY(-9px) scale(1.15);opacity:1;}
}

/* Quick Replies */
.msg-body{display:flex;flex-direction:column;min-width:0;flex:1;}
.quick-replies{display:flex;flex-wrap:wrap;gap:7px;margin-top:8px;animation:qr-in .55s cubic-bezier(0.16,1,0.3,1) both;}
@keyframes qr-in{from{opacity:0;transform:translateY(12px) scale(0.95);}to{opacity:1;transform:translateY(0) scale(1);}}
.qr-btn{
  padding:7px 14px;border-radius:99px;font-size:.74rem;font-weight:600;
  background:rgba(201,147,42,.1);border:1px solid rgba(201,147,42,.25);
  color:#93c5fd;cursor:pointer;transition:all .35s cubic-bezier(0.16,1,0.3,1);white-space:nowrap;
  font-family:'DM Sans',sans-serif;
  position:relative;overflow:hidden;
}
.qr-btn::before{
  content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(201,147,42,.15),transparent);
  opacity:0;transition:opacity .3s;
}
.qr-btn:hover::before{opacity:1;}
.qr-btn:hover{background:rgba(201,147,42,.2);border-color:rgba(201,147,42,.55);transform:translateY(-4px) scale(1.06);box-shadow:0 8px 20px rgba(201,147,42,0.28);}
.qr-btn:active{transform:translateY(-1px) scale(0.98);}
.qr-btn.gold{background:rgba(201,151,42,.1);border-color:rgba(201,151,42,.3);color:var(--gold2);}
.qr-btn.gold::before{background:linear-gradient(135deg,rgba(201,151,42,.15),transparent);}
.qr-btn.gold:hover{background:rgba(201,151,42,.2);border-color:rgba(201,151,42,.55);transform:translateY(-4px) scale(1.06);box-shadow:0 8px 20px rgba(201,151,42,0.28);}

/* Chat Input */
.chat-input-area{
  padding:12px 16px;border-top:1px solid rgba(255,255,255,.07);
  display:flex;gap:10px;align-items:center;flex-shrink:0;
  background:rgba(2,5,14,.5);
}
#chatInput{
  flex:1;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
  border-radius:22px;padding:10px 16px;color:#fff;font-size:.82rem;
  font-family:'DM Sans',sans-serif;outline:none;resize:none;max-height:80px;
  transition:border .3s;
}
#chatInput:focus{border-color:rgba(201,151,42,.5);}
#chatInput::placeholder{color:rgba(255,255,255,.3);}
#chatSend{
  width:38px;height:38px;border-radius:50%;flex-shrink:0;
  background:linear-gradient(135deg,var(--gold),var(--elec));
  border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;
  font-size:.95rem;transition:all .3s var(--spring);
}
#chatSend:hover{transform:scale(1.12);box-shadow:0 6px 20px rgba(201,151,42,.4);}

#intro{position:fixed!important;z-index:10000!important;}
@media(max-width:480px){
  .book-scene{width:230px;height:170px;perspective:1400px;margin-bottom:12px;}
  .book-body{width:230px;height:170px;}
  .book-spine{left:-16px;width:16px;}
  .book-pages{top:5px;bottom:5px;left:7px;right:7px;}
  .book-flap{top:-5px;bottom:-5px;left:-4px;}
  .intro-logo{padding:0 24px;}
