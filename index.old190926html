.ray:nth-child(3){width:2px;height:min(200px,29vh);left:10px;transform:rotate(5deg);animation-delay:2.35s;}
.ray:nth-child(4){width:3px;height:min(240px,35vh);left:48px;transform:rotate(20deg);animation-delay:2.6s;}
@keyframes rays-appear{from{opacity:0;}to{opacity:1;}}
@keyframes ray-breathe{0%,100%{opacity:.25;}50%{opacity:.7;}}
.s-ring{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);border-radius:50%;border:2px solid rgba(201,151,42,.45);animation:ring-expand 3s cubic-bezier(.16,1,.3,1) var(--rd,2.4s) both;pointer-events:none;z-index:1;}
@keyframes ring-expand{0%{width:0;height:0;opacity:1;border-color:rgba(255,220,80,.7);}55%{border-color:rgba(201,147,42,.25);}100%{width:min(900px,160vw);height:min(900px,160vw);opacity:0;}}
.energy-burst{position:absolute;inset:0;pointer-events:none;z-index:15;opacity:0;background:radial-gradient(ellipse at center,rgba(255,220,90,.2),rgba(201,151,42,.1),rgba(201,147,42,.06),transparent 60%);animation:energy-flash .9s ease 2.8s both;}
@keyframes energy-flash{0%{opacity:0;transform:scale(.25);}32%{opacity:1;}100%{opacity:0;transform:scale(2.8);}}

