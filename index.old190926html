@keyframes border-spin { to { --border-angle: 360deg; } }

/* Section divider lines */
section::before {
  content: '';
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  width: 60px; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(201,147,42,.4), transparent);
}
.marquee-strip::before, footer::before { display: none; }

/* Premium hero card — glowing border */
.hero-card {
  position: relative;
  animation: none;
}
.hero-card::after {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: 25px;
  background: linear-gradient(135deg,
    rgba(201,147,42,.25) 0%,
    transparent 40%,
    rgba(201,147,42,.1) 80%,
    transparent 100%);
  z-index: -1;
  pointer-events: none;
}

/* CEO avatar gold ring animation */
.about-ceo-ava {
  animation: gold-pulse 3s ease-in-out infinite;
}
.hero-ceo-ava {
  animation: gold-pulse 3s ease-in-out infinite .5s;
}

/* Course cards — premium 3D on desktop */
@media (min-width: 1025px) {
  .crs-card {
    transform-style: preserve-3d;
    perspective: 1000px;
  }
  .crs-card:hover {
    transform: translateY(-18px) rotateX(4deg) scale(1.04) !important;
    box-shadow: 0 32px 80px rgba(0,0,0,.6), 0 0 40px rgba(201,147,42,.12) !important;
  }
  .hero-card.r {
    animation: hero-float 6s ease-in-out 2s infinite;
  }
  .hero-stat-num {
    animation: counter-glow 3s ease-in-out infinite;
  }
  /* Service cards — mouse-follow glow */
  .svc-card:hover {
    transform: translateY(-12px) scale(1.02) !important;
    box-shadow: 0 28px 70px rgba(0,0,0,.5), 0 0 50px rgba(201,147,42,.1) !important;
  }
  /* Why cards */
  .why-card:hover {
    transform: translateY(-10px) scale(1.02) !important;
  }
}

/* Shimmer effect on section headings */
.section-heading .gold-word {
  position: relative;
  overflow: hidden;
  display: inline-block;
}
.section-heading .gold-word::after {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 60px; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.15), transparent);
  animation: shimmer-line 4s ease-in-out infinite 2s;
}

/* Premium scrollbar */
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: rgba(255,255,255,.02); }
::-webkit-scrollbar-thumb {
