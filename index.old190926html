/* ═══════════════════════════════════════════
   NETWORK BACKGROUND CANVAS
═══════════════════════════════════════════ */
(function(){
  const cv = document.getElementById('networkCanvas');
  if(!cv) return;
  // Skip canvas on very small screens for max mobile perf
  if(window.innerWidth < 480){ cv.style.display='none'; return; }
  const cx = cv.getContext('2d');
  let W, H, nodes=[], mouse={x:-9999,y:-9999};
  const NODE_COUNT = isMobile 
    ? (window.innerWidth < 480 ? 0 : 18)  // minimal on small mobile
    : (window.innerWidth < 1024 ? 50 : 85);
  const CONNECT_DIST = isMobile ? 100 : 180;
  const MOUSE_REACH = 280;
  const MOUSE_REPEL = 120;
  const LANDMARK_PCT = 0.15;

  function resz(){ W=cv.width=window.innerWidth; H=cv.height=window.innerHeight; }
  resz(); window.addEventListener('resize', resz);

  if(!isTouch){
    window.addEventListener('mousemove',e=>{mouse.x=e.clientX;mouse.y=e.clientY;},{passive:true});
  }

  const COLORS=[[201,147,42],[240,196,42],[255,215,70],[232,184,50],[255,255,220]];

  class Node{
    constructor(i){
      this.id=i; this.x=Math.random()*W; this.y=Math.random()*H;
      this.vx=(Math.random()-.5)*.5; this.vy=(Math.random()-.5)*.5;
      this.landmark=Math.random()<LANDMARK_PCT;
      if(this.landmark){ this.r=Math.random()*4+5; this.maxAlpha=1; this.col=Math.random()<.6?COLORS[0]:COLORS[2]; }
      else{ this.r=Math.random()*2+1.5; this.maxAlpha=Math.random()*.5+.4; this.col=COLORS[Math.floor(Math.random()*COLORS.length)]; }
      this.base_r=this.r; this.t=Math.random()*Math.PI*2; this.ts=.008+Math.random()*.018;
    }
    update(){
      this.t+=this.ts;
      const pulse=.65+Math.sin(this.t)*.35;
      this.dr=this.base_r*pulse; this.da=this.maxAlpha*pulse;
      const dx=this.x-mouse.x, dy=this.y-mouse.y;
      const d=Math.sqrt(dx*dx+dy*dy);
      if(d<MOUSE_REPEL&&d>0){ const f=(MOUSE_REPEL-d)/MOUSE_REPEL*1.2; this.vx+=dx/d*f; this.vy+=dy/d*f; }
      this.vx*=.975; this.vy*=.975;
      const spd=Math.sqrt(this.vx*this.vx+this.vy*this.vy);
      if(spd>2){this.vx=this.vx/spd*2;this.vy=this.vy/spd*2;}
      this.x+=this.vx; this.y+=this.vy;
      if(this.x<-30)this.x=W+30; if(this.x>W+30)this.x=-30;
      if(this.y<-30)this.y=H+30; if(this.y>H+30)this.y=-30;
    }
    draw(){
      const [r,g,b]=this.col; cx.save();
      if(this.landmark){
        const g2=cx.createRadialGradient(this.x,this.y,0,this.x,this.y,this.dr*7);
        g2.addColorStop(0,`rgba(${r},${g},${b},${this.da*.55})`);
        g2.addColorStop(.35,`rgba(${r},${g},${b},${this.da*.18})`);
        g2.addColorStop(1,`rgba(${r},${g},${b},0)`);
        cx.beginPath();cx.arc(this.x,this.y,this.dr*7,0,Math.PI*2);cx.fillStyle=g2;cx.fill();
      } else {
        const g4=cx.createRadialGradient(this.x,this.y,0,this.x,this.y,this.dr*3);
        g4.addColorStop(0,`rgba(${r},${g},${b},${this.da*.45})`);
        g4.addColorStop(1,`rgba(${r},${g},${b},0)`);
        cx.beginPath();cx.arc(this.x,this.y,this.dr*3,0,Math.PI*2);cx.fillStyle=g4;cx.fill();
      }
      cx.beginPath();cx.arc(this.x,this.y,this.dr,0,Math.PI*2);
      cx.fillStyle=`rgba(${r},${g},${b},${this.da})`;cx.fill();cx.restore();
    }
  }

  for(let i=0;i<NODE_COUNT;i++) nodes.push(new Node(i));

  function drawConnections(){
    for(let i=0;i<nodes.length;i++){
      for(let j=i+1;j<nodes.length;j++){
        const a=nodes[i],b=nodes[j];
        const dx=a.x-b.x,dy=a.y-b.y;
        const d=Math.sqrt(dx*dx+dy*dy);
        if(d>CONNECT_DIST) continue;
        const fade=1-d/CONNECT_DIST; cx.save();
        if(a.landmark||b.landmark){
          // Removed expensive createLinearGradient for performance
          cx.strokeStyle=`rgba(240,200,74,${fade*.85})`; cx.lineWidth=fade*2.2+.4;
        } else { cx.strokeStyle=`rgba(201,147,42,${fade*.35})`; cx.lineWidth=fade*.9+.3; }
        cx.beginPath();cx.moveTo(a.x,a.y);cx.lineTo(b.x,b.y);cx.stroke();cx.restore();
      }
    }
  }

  function drawMouseWeb(){
    if(isTouch) return;
    const closest=[];
    nodes.forEach(n=>{const dx=n.x-mouse.x,dy=n.y-mouse.y,d=Math.sqrt(dx*dx+dy*dy); if(d<MOUSE_REACH)closest.push({n,d});});
    closest.sort((a,b)=>a.d-b.d);
    closest.slice(0,8).forEach(({n,d})=>{
      const fade=1-d/MOUSE_REACH; cx.save();
      // Removed createLinearGradient to fix GC stutters
      cx.strokeStyle=`rgba(201,151,42,${fade*.8})`; cx.lineWidth=fade*2+.5;
      cx.beginPath();cx.moveTo(mouse.x,mouse.y);cx.lineTo(n.x,n.y);cx.stroke();
      cx.beginPath();cx.arc(mouse.x,mouse.y,3.5,0,Math.PI*2);
      cx.fillStyle=`rgba(201,151,42,${fade*.9})`;cx.fill();cx.restore();
    });
  }

  // Delta-time based loop — smooth at 60Hz, 90Hz AND 120Hz+
  const TARGET_FPS = 90;
  const FRAME_TIME = 1000 / TARGET_FPS;
  let _lastTime = 0;
  let _paused = false;
  document.addEventListener('visibilitychange', () => { _paused = document.hidden; });

  function loop(ts){
    requestAnimationFrame(loop);
    if (_paused) return;
    const cModal = document.getElementById('cModal');
    if (cModal && cModal.classList.contains('open')) return;
    const delta = ts - _lastTime;
    if (delta < FRAME_TIME) return; // skip frame on 120Hz to maintain 60fps logic
    _lastTime = ts - (delta % FRAME_TIME);
    cx.clearRect(0,0,W,H);
    drawConnections(); drawMouseWeb();
    nodes.forEach(n=>{n.update();n.draw();});
  }
  requestAnimationFrame(loop);
})();

