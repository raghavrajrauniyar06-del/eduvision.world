<IfModule mod_rewrite.c>
RewriteEngine On

# If the request is for a real directory or file, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Rewrite /courses/course_name to course-details.html?course=course_name
RewriteRule ^courses/([^/]+)/?$ course-details.html?course=$1 [L,QSA]
</IfModule>
